{
  "$defs": {
    "ActionEnvironment": {
      "enum": [
        "vendor_contact",
        "production"
      ],
      "title": "ActionEnvironment",
      "type": "string"
    },
    "ActionResult": {
      "enum": [
        "succeeded",
        "failed",
        "partial",
        "unknown"
      ],
      "title": "ActionResult",
      "type": "string"
    },
    "ExternalAction": {
      "enum": [
        "send_rights_inquiry",
        "submit_affiliate_application",
        "activate_public_release",
        "disable_public_release"
      ],
      "title": "ExternalAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/ExternalAction"
    },
    "claim_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Claim Sha256",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/ActionEnvironment"
    },
    "external_action_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "External Action Policy Sha256",
      "type": "string"
    },
    "grant_payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Grant Payload Sha256",
      "type": "string"
    },
    "idempotency_key_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Idempotency Key Sha256",
      "type": "string"
    },
    "issuer": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Issuer",
      "type": "string"
    },
    "key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id Sha256",
      "type": "string"
    },
    "observed_post_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observed Post State Sha256",
      "type": "string"
    },
    "observed_pre_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observed Pre State Sha256",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "provider_audit_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Audit Receipt Sha256",
      "type": "string"
    },
    "provider_operation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Operation Sha256",
      "type": "string"
    },
    "receipt_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Id Sha256",
      "type": "string"
    },
    "request_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Request Id",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/ActionResult"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "executor_action_receipt",
      "default": "executor_action_receipt",
      "title": "Scope",
      "type": "string"
    },
    "signature_base64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature Base64Url",
      "type": "string"
    },
    "signer_role": {
      "const": "executor",
      "default": "executor",
      "title": "Signer Role",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "issuer",
    "key_id_sha256",
    "receipt_id_sha256",
    "request_id",
    "request_sha256",
    "grant_payload_sha256",
    "claim_sha256",
    "external_action_policy_sha256",
    "action",
    "environment",
    "idempotency_key_sha256",
    "result",
    "observed_pre_state_sha256",
    "observed_post_state_sha256",
    "provider_operation_sha256",
    "provider_audit_receipt_sha256",
    "started_at",
    "completed_at",
    "payload_sha256",
    "signature_base64url"
  ],
  "title": "ActionReceipt",
  "type": "object"
}

    "cohort_id",
    "currency",
    "partner_ids",
    "amendment_sha256s",
    "completeness_attestation_sha256s",
    "applied_event_root_sha256",
    "final_transaction_state_root_sha256",
    "applied_event_count",
    "replayed_amendment_occurrences",
    "replayed_event_occurrences",
    "original_settled_amount",
    "amended_settled_amount",
    "settled_delta",
    "positive_settled_delta",
    "negative_settled_delta",
    "partner_settlements",

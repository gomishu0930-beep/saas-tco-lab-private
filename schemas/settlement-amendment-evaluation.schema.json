      },
      "minItems": 1,
      "title": "Partner Ids",
      "type": "array"
    },
    "partner_settlements": {
      "items": {
        "$ref": "#/$defs/PartnerSettlementAmount"
      },
      "minItems": 1,
      "title": "Partner Settlements",
      "type": "array"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "positive_settled_delta": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,25}0*$)\\d{0,16}\\.\\d{0,8}0*$)",
          "type": "string"
        }
      ],
      "title": "Positive Settled Delta"
    },
    "replayed_amendment_occurrences": {
      "minimum": 0,
      "title": "Replayed Amendment Occurrences",
      "type": "integer"
    },
    "replayed_event_occurrences": {
      "minimum": 0,
      "title": "Replayed Event Occurrences",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "settled_delta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,25}0*$)\\d{0,16}\\.\\d{0,8}0*$)",
          "type": "string"
        }

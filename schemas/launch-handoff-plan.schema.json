{
  "$defs": {
    "LaunchArtifactComponent": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/LaunchArtifactComponentKind"
        },
        "schema_version": {
          "const": "3.0",
          "default": "3.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "artifact_sha256"
      ],
      "title": "LaunchArtifactComponent",
      "type": "object"
    },
    "LaunchArtifactComponentKind": {
      "enum": [
        "p18_repository_acceptance_authority_bundle",
        "rights_decision_record",
        "affiliate_decision_record",
        "qualified_demand_record",
        "shadow_operations_record",
        "gold_source_readiness_record",
        "p15_readiness_report",
        "p15_tco_qa_attestation",
        "p10_local_assurance_report",
        "deployment_readiness_record",
        "publication_readiness_record"
      ],
      "title": "LaunchArtifactComponentKind",
      "type": "string"
    },
    "LaunchHandoffGate": {
      "enum": [
        "local_candidate_acceptance",
        "rights_approval",
        "affiliate_acceptance",
        "qualified_demand",
        "shadow_operations",
        "gold_set_source_readiness",
        "production_integration_readiness",
        "deployment_publication_readiness"
      ],
      "title": "LaunchHandoffGate",
      "type": "string"
    },
    "LaunchHandoffRequirement": {
      "additionalProperties": false,
      "properties": {
        "artifact_components": {
          "items": {
            "$ref": "#/$defs/LaunchArtifactComponent"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Artifact Components",
          "type": "array"
        },
        "command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Sha256",
          "type": "string"
        },
        "evidence_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Identity Sha256",
          "type": "string"
        },
        "expected_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Artifact Sha256",
          "type": "string"
        },
        "gate": {
          "$ref": "#/$defs/LaunchHandoffGate"
        },
        "schema_version": {
          "const": "3.0",
          "default": "3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "signer_key_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signer Key Id Sha256",
          "type": "string"
        },
        "signer_role": {
          "$ref": "#/$defs/SigningRole"
        },
        "subject_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Subject Sha256",
          "type": "string"
        },
        "tool_name": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$",
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "evidence_identity_sha256",
        "artifact_components",
        "expected_artifact_sha256",
        "subject_sha256",
        "signer_role",
        "signer_key_id_sha256",
        "command_sha256",
        "tool_name",
        "tool_version"
      ],
      "title": "LaunchHandoffRequirement",
      "type": "object"
    },
    "SigningRole": {
      "enum": [
        "controller",
        "tco_qa",
        "human_approver",
        "executor",
        "demand_producer",
        "cohort_producer",
        "operations_producer",
        "measurement_human",
        "measurement_indexer",
        "provider_adapter",
        "provider_probe",
        "integration_evidence_runner",
        "provider_conformance",
        "security_auditor",
        "storage_auditor",
        "time_auditor",
        "network_auditor",
        "recovery_auditor"
      ],
      "title": "SigningRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "affiliate_disclosure_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Affiliate Disclosure Sha256",
      "type": "string"
    },
    "candidate_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Manifest Sha256",
      "type": "string"
    },
    "deployment_candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Deployment Candidate Sha256",
      "type": "string"
    },
    "environment_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Identity Sha256",
      "type": "string"
    },
    "expected_post_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Post State Sha256",
      "type": "string"
    },
    "expected_pre_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Pre State Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "handoff_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Handoff Policy Sha256",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "launch_semantic_authority_pins_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Launch Semantic Authority Pins Sha256",
      "type": "string"
    },
    "legal_pages_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Legal Pages Sha256",
      "type": "string"
    },
    "not_before": {
      "format": "date-time",
      "title": "Not Before",
      "type": "string"
    },
    "plan_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "property_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Property Record Sha256",
      "type": "string"
    },
    "provider_target_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Target Sha256",
      "type": "string"
    },
    "release_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Release Artifact Sha256",
      "type": "string"
    },
    "release_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Release Identity Sha256",
      "type": "string"
    },
    "release_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Release Manifest Sha256",
      "type": "string"
    },
    "repository_acceptance_authority_pins_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Repository Acceptance Authority Pins Sha256",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/LaunchHandoffRequirement"
      },
      "maxItems": 8,
      "minItems": 8,
      "title": "Requirements",
      "type": "array"
    },
    "rollback_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rollback State Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "3.0",
      "default": "3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trust_store_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trust Store Sha256",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "handoff_policy_sha256",
    "trust_store_sha256",
    "repository_acceptance_authority_pins_sha256",
    "launch_semantic_authority_pins_sha256",
    "candidate_manifest_sha256",
    "property_record_sha256",
    "environment_identity_sha256",
    "release_identity_sha256",
    "release_manifest_sha256",
    "release_artifact_sha256",
    "deployment_candidate_sha256",
    "provider_target_sha256",
    "expected_pre_state_sha256",
    "expected_post_state_sha256",
    "rollback_state_sha256",
    "legal_pages_sha256",
    "affiliate_disclosure_sha256",
    "issued_at",
    "not_before",
    "expires_at",
    "requirements",
    "plan_sha256"
  ],
  "title": "LaunchHandoffPlan",
  "type": "object"
}

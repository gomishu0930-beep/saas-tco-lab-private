{
  "$defs": {
    "PayoutAdjustmentKind": {
      "enum": [
        "refund",
        "chargeback"
      ],
      "title": "PayoutAdjustmentKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adjustment_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adjustment Id Sha256",
      "type": "string"
    },
    "adjustment_kind": {
      "$ref": "#/$defs/PayoutAdjustmentKind"
    },
    "amount": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,25}0*$)\\d{0,16}\\.\\d{0,8}0*$)",
          "type": "string"
        }
      ],
      "title": "Amount"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "event_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Event Id Sha256",
      "type": "string"
    },
    "kind": {
      "const": "payout_adjustment",
      "default": "payout_adjustment",
      "title": "Kind",
      "type": "string"
    },
    "original_transaction_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Original Transaction Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_row_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Row Sha256",
      "type": "string"
    },
    "transaction_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transaction Id Sha256",
      "type": "string"
    }
  },
  "required": [
    "event_id_sha256",
    "transaction_id_sha256",
    "original_transaction_sha256",
    "adjustment_id_sha256",
    "adjustment_kind",
    "amount",
    "currency",
    "source_row_sha256",
    "effective_at"
  ],
  "title": "SettlementPayoutAdjustment",
  "type": "object"
}

{
  "additionalProperties": false,
  "properties": {
    "partner_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Partner Id",
      "type": "string"
    },
    "settled_amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,22}|(?=[\\d.]{1,31}0*$)\\d{0,22}\\.\\d{0,8}0*$)",
          "type": "string"
        }
      ],
      "title": "Settled Amount"
    }
  },
  "required": [
    "partner_id",
    "settled_amount"
  ],
  "title": "PartnerTractionFacts",
  "type": "object"
}

{
  "$defs": {
    "AcquisitionMethod": {
      "enum": [
        "official_api",
        "vendor_feed",
        "direct_http",
        "browser",
        "manual"
      ],
      "title": "AcquisitionMethod",
      "type": "string"
    },
    "AddonPrice": {
      "additionalProperties": false,
      "properties": {
        "billing_period": {
          "$ref": "#/$defs/BillingPeriod"
        },
        "code": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Code",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "pricing_model": {
          "$ref": "#/$defs/PricingModel"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "unit_name": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Name"
        },
        "unit_price": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,25}0*$)\\d{0,16}\\.\\d{0,8}0*$)",
              "type": "string"
            }
          ],
          "title": "Unit Price"
        }
      },
      "required": [
        "code",
        "name",
        "required",
        "unit_price",
        "billing_period",
        "pricing_model"
      ],
      "title": "AddonPrice",
      "type": "object"
    },
    "BillingPeriod": {
      "enum": [
        "monthly",
        "annual"
      ],
      "title": "BillingPeriod",
      "type": "string"
    },
    "CandidateBatch": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/CandidateParseFailure"
          },
          "title": "Failures",
          "type": "array"
        },
        "parser_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parser Sha256",
          "type": "string"
        },
        "parser_version": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9]+(?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
          "title": "Parser Version",
          "type": "string"
        },
        "plans": {
          "items": {
            "$ref": "#/$defs/CandidatePlan"
          },
          "title": "Plans",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Receipt Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_receipt_sha256",
        "parser_sha256",
        "parser_version",
        "captured_at",
        "expires_at",
        "plans",
        "failures"
      ],
      "title": "CandidateBatch",
      "type": "object"
    },
    "CandidateParseFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ParseFailureCode"
        },
        "error_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Error Sha256",
          "type": "string"
        },
        "expected_plan_slug": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Expected Plan Slug",
          "type": "string"
        },
        "expected_vendor_slug": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Expected Vendor Slug",
          "type": "string"
        },
        "input_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Id Sha256",
          "type": "string"
        }
      },
      "required": [
        "input_id_sha256",
        "expected_vendor_slug",
        "expected_plan_slug",
        "code",
        "error_sha256"
      ],
      "title": "CandidateParseFailure",
      "type": "object"
    },
    "CandidatePlan": {
      "additionalProperties": false,
      "properties": {
        "input_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Id Sha256",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/VendorPlan"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        }
      },
      "required": [
        "input_id_sha256",
        "plan_sha256",
        "plan"
      ],
      "title": "CandidatePlan",
      "type": "object"
    },
    "Ed25519VerificationKey": {
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$",
          "title": "Issuer",
          "type": "string"
        },
        "key_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Key Id Sha256",
          "type": "string"
        },
        "public_key_base64url": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "title": "Public Key Base64Url",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/SigningRole"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "role",
        "key_id_sha256",
        "public_key_base64url"
      ],
      "title": "Ed25519VerificationKey",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "fact",
        "paraphrase",
        "quote"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidencePointer": {
      "additionalProperties": false,
      "description": "Minimal, attributable evidence for a single normalized field.",
      "properties": {
        "evidence_kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "excerpt": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "raw_archive": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawArchivePointer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_policy": {
          "$ref": "#/$defs/SourcePolicy"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "retrieved_at",
        "sha256",
        "evidence_kind",
        "excerpt",
        "source_policy"
      ],
      "title": "EvidencePointer",
      "type": "object"
    },
    "FieldEvidence": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Field",
          "type": "string"
        },
        "pointers": {
          "items": {
            "$ref": "#/$defs/EvidencePointer"
          },
          "minItems": 1,
          "title": "Pointers",
          "type": "array"
        }
      },
      "required": [
        "field",
        "pointers"
      ],
      "title": "FieldEvidence",
      "type": "object"
    },
    "GoldFieldLabel": {
      "additionalProperties": false,
      "properties": {
        "evidence_source_sha256s": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Source Sha256S",
          "type": "array"
        },
        "expected_value_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Value Sha256",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "field_path": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Field Path",
          "type": "string"
        },
        "human_label_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Human Label Receipt Sha256",
          "type": "string"
        },
        "label_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Label Id Sha256",
          "type": "string"
        },
        "labeled_at": {
          "format": "date-time",
          "title": "Labeled At",
          "type": "string"
        }
      },
      "required": [
        "label_id_sha256",
        "field_path",
        "expected_value_sha256",
        "evidence_source_sha256s",
        "human_label_receipt_sha256",
        "labeled_at",
        "expires_at"
      ],
      "title": "GoldFieldLabel",
      "type": "object"
    },
    "GoldPlan": {
      "additionalProperties": false,
      "properties": {
        "labels": {
          "items": {
            "$ref": "#/$defs/GoldFieldLabel"
          },
          "minItems": 1,
          "title": "Labels",
          "type": "array"
        },
        "plan_slug": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Plan Slug",
          "type": "string"
        },
        "tco_expectations": {
          "items": {
            "$ref": "#/$defs/GoldTcoExpectation"
          },
          "minItems": 1,
          "title": "Tco Expectations",
          "type": "array"
        },
        "vendor_slug": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Vendor Slug",
          "type": "string"
        }
      },
      "required": [
        "vendor_slug",
        "plan_slug",
        "labels",
        "tco_expectations"
      ],
      "title": "GoldPlan",
      "type": "object"
    },
    "GoldReportAttestation": {
      "additionalProperties": false,
      "properties": {
        "candidate_batch_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Batch Sha256",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "gold_report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Gold Report Sha256",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "issuer": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$",
          "title": "Issuer",
          "type": "string"
        },
        "key_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Key Id Sha256",
          "type": "string"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "rights_bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rights Bundle Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "const": "gold_report_acceptance",
          "default": "gold_report_acceptance",
          "title": "Scope",
          "type": "string"
        },
        "signature_base64url": {
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "title": "Signature Base64Url",
          "type": "string"
        },
        "signer_role": {
          "const": "tco_qa",
          "default": "tco_qa",
          "title": "Signer Role",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "key_id_sha256",
        "gold_report_sha256",
        "rights_bundle_sha256",
        "candidate_batch_sha256",
        "issued_at",
        "expires_at",
        "payload_sha256",
        "signature_base64url"
      ],
      "title": "GoldReportAttestation",
      "type": "object"
    },
    "GoldSetReport": {
      "additionalProperties": false,
      "properties": {
        "candidate_batch_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Batch Sha256",
          "type": "string"
        },
        "candidate_plan_count": {
          "minimum": 0,
          "title": "Candidate Plan Count",
          "type": "integer"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "full_goldset_coverage": {
          "title": "Full Goldset Coverage",
          "type": "boolean"
        },
        "gold_label_count": {
          "minimum": 0,
          "title": "Gold Label Count",
          "type": "integer"
        },
        "gold_plan_count": {
          "minimum": 0,
          "title": "Gold Plan Count",
          "type": "integer"
        },
        "gold_vendor_count": {
          "minimum": 0,
          "title": "Gold Vendor Count",
          "type": "integer"
        },
        "goldset_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Goldset Content Sha256",
          "type": "string"
        },
        "goldset_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Goldset Id Sha256",
          "type": "string"
        },
        "parse_failure_count": {
          "minimum": 0,
          "title": "Parse Failure Count",
          "type": "integer"
        },
        "parse_failure_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Parse Failure Rate"
        },
        "parser_failure_stop": {
          "title": "Parser Failure Stop",
          "type": "boolean"
        },
        "quarantines": {
          "items": {
            "$ref": "#/$defs/QuarantineItem"
          },
          "title": "Quarantines",
          "type": "array"
        },
        "ready_for_release": {
          "title": "Ready For Release",
          "type": "boolean"
        },
        "report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Sha256",
          "type": "string"
        },
        "rights_bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rights Bundle Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.1",
          "default": "1.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "goldset_id_sha256",
        "goldset_content_sha256",
        "rights_bundle_sha256",
        "candidate_batch_sha256",
        "evaluated_at",
        "expires_at",
        "gold_vendor_count",
        "gold_plan_count",
        "gold_label_count",
        "candidate_plan_count",
        "parse_failure_count",
        "parse_failure_rate",
        "parser_failure_stop",
        "full_goldset_coverage",
        "ready_for_release",
        "quarantines",
        "report_sha256"
      ],
      "title": "GoldSetReport",
      "type": "object"
    },
    "GoldTcoExpectation": {
      "additionalProperties": false,
      "properties": {
        "expected_currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Expected Currency",
          "type": "string"
        },
        "expected_tco_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Tco Sha256",
          "type": "string"
        },
        "expected_total_minor": {
          "minimum": 0,
          "title": "Expected Total Minor",
          "type": "integer"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "human_label_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Human Label Receipt Sha256",
          "type": "string"
        },
        "labeled_at": {
          "format": "date-time",
          "title": "Labeled At",
          "type": "string"
        },
        "monthly_usage": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Monthly Usage"
        },
        "months": {
          "const": 12,
          "default": 12,
          "title": "Months",
          "type": "integer"
        },
        "scenario_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scenario Id Sha256",
          "type": "string"
        },
        "seats": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Seats",
          "type": "integer"
        },
        "selected_addon_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Selected Addon Codes",
          "type": "array"
        },
        "usage_unit": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage Unit"
        }
      },
      "required": [
        "scenario_id_sha256",
        "human_label_receipt_sha256",
        "labeled_at",
        "expires_at",
        "seats",
        "monthly_usage",
        "expected_tco_sha256",
        "expected_total_minor",
        "expected_currency"
      ],
      "title": "GoldTcoExpectation",
      "type": "object"
    },
    "HumanGoldSet": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "goldset_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Goldset Id Sha256",
          "type": "string"
        },
        "plans": {
          "items": {
            "$ref": "#/$defs/GoldPlan"
          },
          "minItems": 1,
          "title": "Plans",
          "type": "array"
        },
        "rights_bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rights Bundle Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "goldset_id_sha256",
        "rights_bundle_sha256",
        "created_at",
        "expires_at",
        "plans"
      ],
      "title": "HumanGoldSet",
      "type": "object"
    },
    "ParseFailureCode": {
      "enum": [
        "parse_error",
        "validation_error",
        "unsupported",
        "ambiguous",
        "source_conflict",
        "rights_invalid"
      ],
      "title": "ParseFailureCode",
      "type": "string"
    },
    "PolicyDecision": {
      "description": "An explicit decision.  Missing review is never equivalent to approval.",
      "enum": [
        "approved",
        "prohibited",
        "unreviewed"
      ],
      "title": "PolicyDecision",
      "type": "string"
    },
    "PricingModel": {
      "enum": [
        "flat",
        "per_seat",
        "per_usage"
      ],
      "title": "PricingModel",
      "type": "string"
    },
    "QuarantineItem": {
      "additionalProperties": false,
      "properties": {
        "actual_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Sha256"
        },
        "expected_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sha256"
        },
        "reason": {
          "$ref": "#/$defs/QuarantineReason"
        },
        "subject_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Subject Sha256",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "subject_sha256"
      ],
      "title": "QuarantineItem",
      "type": "object"
    },
    "QuarantineReason": {
      "enum": [
        "partial_goldset",
        "goldset_not_current",
        "candidate_not_current",
        "parse_failure",
        "parser_failure_rate",
        "missing_plan",
        "extra_plan",
        "missing_field",
        "extra_field",
        "field_mismatch",
        "source_mismatch",
        "rights_invalid",
        "label_not_current",
        "tco_mismatch",
        "tco_error"
      ],
      "title": "QuarantineReason",
      "type": "string"
    },
    "RawArchivePointer": {
      "additionalProperties": false,
      "description": "Metadata pointer only; raw source bytes never enter the pricing record.",
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "delete_after": {
          "format": "date-time",
          "title": "Delete After",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "captured_at",
        "delete_after"
      ],
      "title": "RawArchivePointer",
      "type": "object"
    },
    "SeatPricing": {
      "additionalProperties": false,
      "description": "Price for each billable seat.\n\nPhase 1 intentionally excludes hybrid platform-fee/included-seat products:\n``included_seats`` is fixed to zero and VendorPlan validates that the unit\nprice equals its advertised ``base_price``.",
      "properties": {
        "included_seats": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Included Seats",
          "type": "integer"
        },
        "maximum_seats": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Seats"
        },
        "minimum_seats": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Minimum Seats",
          "type": "integer"
        },
        "unit_price": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,25}0*$)\\d{0,16}\\.\\d{0,8}0*$)",
              "type": "string"
            }
          ],
          "description": "Advertised per-seat price for one billing period",
          "title": "Unit Price"
        }
      },
      "required": [
        "unit_price",
        "minimum_seats"
      ],
      "title": "SeatPricing",
      "type": "object"
    },
    "SigningRole": {
      "enum": [
        "controller",
        "tco_qa",
        "human_approver",
        "executor",
        "demand_producer",
        "cohort_producer",
        "operations_producer",
        "measurement_human",
        "measurement_indexer",
        "provider_adapter",
        "provider_probe",
        "integration_evidence_runner",
        "provider_conformance",
        "security_auditor",
        "storage_auditor",
        "time_auditor",
        "network_auditor",
        "recovery_auditor"
      ],
      "title": "SigningRole",
      "type": "string"
    },
    "SourcePolicy": {
      "additionalProperties": false,
      "description": "Field-level permission record for one source and one review window.\n\nEvery capability defaults to ``unreviewed``.  Callers must use ``permits``\ninstead of testing enum truthiness; enum members are intentionally never\nbooleans.",
      "properties": {
        "acquisition_method": {
          "$ref": "#/$defs/AcquisitionMethod"
        },
        "attribution_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution Required"
        },
        "attribution_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution Text"
        },
        "basis": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "basis_url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis Url"
        },
        "derive": {
          "$ref": "#/$defs/PolicyDecision",
          "default": "unreviewed"
        },
        "fetch": {
          "$ref": "#/$defs/PolicyDecision",
          "default": "unreviewed"
        },
        "field": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Field",
          "type": "string"
        },
        "max_quote_chars": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Quote Chars"
        },
        "policy_id": {
          "format": "uuid",
          "title": "Policy Id",
          "type": "string"
        },
        "publish": {
          "$ref": "#/$defs/PolicyDecision",
          "default": "unreviewed"
        },
        "quote": {
          "$ref": "#/$defs/PolicyDecision",
          "default": "unreviewed"
        },
        "retain_history": {
          "$ref": "#/$defs/PolicyDecision",
          "default": "unreviewed"
        },
        "retention_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention Days"
        },
        "review_due_at": {
          "format": "date-time",
          "title": "Review Due At",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewed_by": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Reviewed By",
          "type": "string"
        },
        "send_to_ai": {
          "$ref": "#/$defs/PolicyDecision",
          "default": "unreviewed"
        },
        "source_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "store_raw": {
          "$ref": "#/$defs/PolicyDecision",
          "default": "unreviewed"
        }
      },
      "required": [
        "field",
        "source_url",
        "acquisition_method",
        "reviewed_at",
        "review_due_at",
        "reviewed_by",
        "basis"
      ],
      "title": "SourcePolicy",
      "type": "object"
    },
    "TaxSpec": {
      "additionalProperties": false,
      "properties": {
        "rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,8}0*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate"
        },
        "treatment": {
          "$ref": "#/$defs/TaxTreatment"
        }
      },
      "required": [
        "treatment"
      ],
      "title": "TaxSpec",
      "type": "object"
    },
    "TaxTreatment": {
      "enum": [
        "included",
        "excluded",
        "not_applicable"
      ],
      "title": "TaxTreatment",
      "type": "string"
    },
    "UsageAllowance": {
      "additionalProperties": false,
      "properties": {
        "billing_period": {
          "$ref": "#/$defs/BillingPeriod"
        },
        "included_quantity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,22}|(?=[\\d.]{1,31}0*$)\\d{0,22}\\.\\d{0,8}0*$)",
              "type": "string"
            }
          ],
          "title": "Included Quantity"
        },
        "overage_unit_price": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,25}0*$)\\d{0,16}\\.\\d{0,8}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overage Unit Price"
        },
        "unit_name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Unit Name",
          "type": "string"
        }
      },
      "required": [
        "unit_name",
        "billing_period",
        "included_quantity"
      ],
      "title": "UsageAllowance",
      "type": "object"
    },
    "VendorPlan": {
      "additionalProperties": false,
      "description": "Immutable price snapshot with evidence for every material input.\n\nFor ``flat`` pricing, ``base_price`` is the fixed charge per billing period.\nFor ``per_seat`` pricing, it is the advertised one-seat price and must equal\n``seat_pricing.unit_price``.  Hybrid platform-fee/included-seat products are\ndeferred to a future schema version so Phase 1 TCO cannot double-count them.",
      "properties": {
        "addons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AddonPrice"
          },
          "title": "Addons",
          "type": "array"
        },
        "base_price": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,25}0*$)\\d{0,16}\\.\\d{0,8}0*$)",
              "type": "string"
            }
          ],
          "description": "Flat period charge, or advertised one-seat price for per-seat plans",
          "title": "Base Price"
        },
        "billing_period": {
          "$ref": "#/$defs/BillingPeriod"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "commitment_months": {
          "maximum": 120,
          "minimum": 1,
          "title": "Commitment Months",
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "effective_at": {
          "format": "date-time",
          "title": "Effective At",
          "type": "string"
        },
        "field_evidence": {
          "items": {
            "$ref": "#/$defs/FieldEvidence"
          },
          "minItems": 1,
          "title": "Field Evidence",
          "type": "array"
        },
        "minor_unit_digits": {
          "maximum": 6,
          "minimum": 0,
          "title": "Minor Unit Digits",
          "type": "integer"
        },
        "plan_name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Plan Name",
          "type": "string"
        },
        "plan_slug": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Plan Slug",
          "type": "string"
        },
        "pricing_model": {
          "$ref": "#/$defs/PricingModel"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seat_pricing": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeatPricing"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        },
        "tax": {
          "$ref": "#/$defs/TaxSpec"
        },
        "usage_allowance": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageAllowance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vendor_name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Vendor Name",
          "type": "string"
        },
        "vendor_slug": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Vendor Slug",
          "type": "string"
        }
      },
      "required": [
        "vendor_slug",
        "vendor_name",
        "plan_slug",
        "plan_name",
        "captured_at",
        "effective_at",
        "currency",
        "minor_unit_digits",
        "billing_period",
        "commitment_months",
        "pricing_model",
        "base_price",
        "tax",
        "field_evidence"
      ],
      "title": "VendorPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attestation": {
      "$ref": "#/$defs/GoldReportAttestation"
    },
    "candidates": {
      "$ref": "#/$defs/CandidateBatch"
    },
    "goldset": {
      "$ref": "#/$defs/HumanGoldSet"
    },
    "report": {
      "$ref": "#/$defs/GoldSetReport"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tco_qa_verifier": {
      "$ref": "#/$defs/Ed25519VerificationKey"
    }
  },
  "required": [
    "goldset",
    "candidates",
    "report",
    "attestation",
    "tco_qa_verifier"
  ],
  "title": "GoldSemanticPacket",
  "type": "object"
}

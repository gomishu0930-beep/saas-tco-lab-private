{
  "$defs": {
    "ProductionFactsKind": {
      "enum": [
        "backup_restore",
        "egress_allowlist",
        "external_monotonic_anchor",
        "independent_readback",
        "kms_identity_separation",
        "provider_conditional_mutation",
        "provider_idempotency_retention",
        "provider_receipt_lookup",
        "rollback_disable",
        "shared_durable_store_fencing",
        "trusted_clock"
      ],
      "title": "ProductionFactsKind",
      "type": "string"
    },
    "ProductionIntegrationCheck": {
      "enum": [
        "backup_restore",
        "egress_allowlist",
        "external_monotonic_anchor",
        "independent_readback",
        "kms_identity_separation",
        "provider_conditional_mutation",
        "provider_idempotency_retention",
        "provider_receipt_lookup",
        "rollback_disable",
        "shared_durable_store_fencing",
        "trusted_clock"
      ],
      "title": "ProductionIntegrationCheck",
      "type": "string"
    },
    "ProductionIntegrationRequirement": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "$ref": "#/$defs/ProductionIntegrationCheck"
        },
        "command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Sha256",
          "type": "string"
        },
        "evidence_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Identity Sha256",
          "type": "string"
        },
        "facts_kind": {
          "$ref": "#/$defs/ProductionFactsKind"
        },
        "signer_key_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signer Key Id Sha256",
          "type": "string"
        },
        "signer_role": {
          "$ref": "#/$defs/SigningRole"
        },
        "subject_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Subject Sha256",
          "type": "string"
        },
        "tool_name": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "check",
        "facts_kind",
        "evidence_identity_sha256",
        "signer_role",
        "signer_key_id_sha256",
        "subject_sha256",
        "command_sha256",
        "tool_name",
        "tool_version"
      ],
      "title": "ProductionIntegrationRequirement",
      "type": "object"
    },
    "SigningRole": {
      "enum": [
        "controller",
        "tco_qa",
        "human_approver",
        "executor",
        "demand_producer",
        "cohort_producer",
        "operations_producer",
        "measurement_human",
        "measurement_indexer",
        "provider_adapter",
        "provider_probe",
        "integration_evidence_runner",
        "provider_conformance",
        "security_auditor",
        "storage_auditor",
        "time_auditor",
        "network_auditor",
        "recovery_auditor"
      ],
      "title": "SigningRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter_closure_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adapter Closure Sha256",
      "type": "string"
    },
    "deployment_candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Deployment Candidate Sha256",
      "type": "string"
    },
    "environment_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Identity Sha256",
      "type": "string"
    },
    "expected_pre_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Pre State Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "integration_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Integration Policy Sha256",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "not_before": {
      "format": "date-time",
      "title": "Not Before",
      "type": "string"
    },
    "p11_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "P11 Policy Sha256",
      "type": "string"
    },
    "p11_store_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "P11 Store Identity Sha256",
      "type": "string"
    },
    "p13_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "P13 Policy Sha256",
      "type": "string"
    },
    "p13_store_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "P13 Store Identity Sha256",
      "type": "string"
    },
    "plan_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "probe_closure_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Probe Closure Sha256",
      "type": "string"
    },
    "property_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Property Record Sha256",
      "type": "string"
    },
    "provider_account_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Account Sha256",
      "type": "string"
    },
    "provider_capability_profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Capability Profile Sha256",
      "type": "string"
    },
    "provider_target_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Target Sha256",
      "type": "string"
    },
    "reconciliation_ledger_store_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reconciliation Ledger Store Sha256",
      "type": "string"
    },
    "release_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Release Artifact Sha256",
      "type": "string"
    },
    "release_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Release Manifest Sha256",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/ProductionIntegrationRequirement"
      },
      "maxItems": 11,
      "minItems": 11,
      "title": "Requirements",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trust_store_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trust Store Sha256",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "integration_policy_sha256",
    "trust_store_sha256",
    "property_record_sha256",
    "environment_identity_sha256",
    "provider_account_sha256",
    "p11_policy_sha256",
    "p11_store_identity_sha256",
    "p13_policy_sha256",
    "p13_store_identity_sha256",
    "reconciliation_ledger_store_sha256",
    "release_artifact_sha256",
    "release_manifest_sha256",
    "adapter_closure_sha256",
    "probe_closure_sha256",
    "provider_capability_profile_sha256",
    "deployment_candidate_sha256",
    "provider_target_sha256",
    "expected_pre_state_sha256",
    "issued_at",
    "not_before",
    "expires_at",
    "requirements",
    "plan_sha256"
  ],
  "title": "ProductionIntegrationPlan",
  "type": "object"
}

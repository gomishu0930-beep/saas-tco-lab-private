{
  "$defs": {
    "HumanRepositoryDecision": {
      "enum": [
        "go",
        "conditional",
        "stop"
      ],
      "title": "HumanRepositoryDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approver_issuer": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Approver Issuer",
      "type": "string"
    },
    "approver_key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approver Key Id Sha256",
      "type": "string"
    },
    "condition_ids": {
      "default": [],
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Condition Ids",
      "type": "array"
    },
    "decision": {
      "$ref": "#/$defs/HumanRepositoryDecision"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "predecessor_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Predecessor Receipt Sha256",
      "type": "string"
    },
    "receipt_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Receipt Id",
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Sha256",
      "type": "string"
    },
    "revision": {
      "maximum": 1000000000,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature_base64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature Base64Url",
      "type": "string"
    },
    "trust_store_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trust Store Sha256",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "manifest_sha256",
    "policy_sha256",
    "trust_store_sha256",
    "revision",
    "predecessor_receipt_sha256",
    "decision",
    "issued_at",
    "expires_at",
    "approver_issuer",
    "approver_key_id_sha256",
    "receipt_sha256",
    "signature_base64url"
  ],
  "title": "HumanRepositoryAcceptance",
  "type": "object"
}

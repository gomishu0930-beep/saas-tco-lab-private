{
  "$defs": {
    "CohortEvidence": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "cohort": {
          "$ref": "#/$defs/CohortInput"
        },
        "evidence_version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Evidence Version",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "status_mapping_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Status Mapping Sha256",
          "type": "string"
        }
      },
      "required": [
        "evidence_version",
        "source_sha256",
        "status_mapping_sha256",
        "captured_at",
        "expires_at",
        "cohort"
      ],
      "title": "CohortEvidence",
      "type": "object"
    },
    "CohortInput": {
      "additionalProperties": false,
      "properties": {
        "age_days": {
          "minimum": 0,
          "title": "Age Days",
          "type": "integer"
        },
        "commissions": {
          "$ref": "#/$defs/CommissionInput"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "valid_clicks": {
          "minimum": 0,
          "title": "Valid Clicks",
          "type": "integer"
        }
      },
      "required": [
        "currency",
        "valid_clicks",
        "age_days",
        "commissions"
      ],
      "title": "CohortInput",
      "type": "object"
    },
    "CommissionInput": {
      "additionalProperties": false,
      "properties": {
        "confirmed": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Confirmed"
        },
        "paid": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Paid"
        },
        "pending": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Pending"
        },
        "rejected": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Rejected"
        }
      },
      "required": [
        "pending",
        "rejected",
        "confirmed",
        "paid"
      ],
      "title": "CommissionInput",
      "type": "object"
    },
    "DemandEvidence": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "evidence_version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Evidence Version",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "scenarios": {
          "$ref": "#/$defs/ScenarioInputs"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "evidence_version",
        "source_sha256",
        "captured_at",
        "expires_at",
        "scenarios"
      ],
      "title": "DemandEvidence",
      "type": "object"
    },
    "DemandInput": {
      "additionalProperties": false,
      "properties": {
        "deduplicated_search_volume": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Deduplicated Search Volume"
        },
        "organic_visibility": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Organic Visibility"
        },
        "outbound_click_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Outbound Click Rate"
        },
        "qualified_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Qualified Rate"
        },
        "rank_ctr": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Rank Ctr"
        },
        "volume_is_deduplicated": {
          "title": "Volume Is Deduplicated",
          "type": "boolean"
        }
      },
      "required": [
        "deduplicated_search_volume",
        "organic_visibility",
        "rank_ctr",
        "qualified_rate",
        "outbound_click_rate",
        "volume_is_deduplicated"
      ],
      "title": "DemandInput",
      "type": "object"
    },
    "MeasurementReconciliationFacts": {
      "additionalProperties": false,
      "properties": {
        "affiliate_accepted_clicks": {
          "minimum": 0,
          "title": "Affiliate Accepted Clicks",
          "type": "integer"
        },
        "confirmed_epc": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confirmed Epc"
        },
        "current_transactions": {
          "minimum": 0,
          "title": "Current Transactions",
          "type": "integer"
        },
        "exact_faults_passed": {
          "maximum": 8,
          "minimum": 0,
          "title": "Exact Faults Passed",
          "type": "integer"
        },
        "gross_paid_transactions": {
          "minimum": 0,
          "title": "Gross Paid Transactions",
          "type": "integer"
        },
        "gross_payout_amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Gross Payout Amount"
        },
        "net_paid_transactions": {
          "minimum": 0,
          "title": "Net Paid Transactions",
          "type": "integer"
        },
        "net_payout_amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Net Payout Amount"
        },
        "net_payout_epc": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Net Payout Epc"
        },
        "new_acquisition_transactions": {
          "minimum": 0,
          "title": "New Acquisition Transactions",
          "type": "integer"
        },
        "qualified_sessions": {
          "minimum": 0,
          "title": "Qualified Sessions",
          "type": "integer"
        },
        "reversed_paid_transactions": {
          "minimum": 0,
          "title": "Reversed Paid Transactions",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "settled_new_acquisition_amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Settled New Acquisition Amount"
        },
        "valid_outbound_clicks": {
          "minimum": 0,
          "title": "Valid Outbound Clicks",
          "type": "integer"
        }
      },
      "required": [
        "qualified_sessions",
        "valid_outbound_clicks",
        "affiliate_accepted_clicks",
        "current_transactions",
        "new_acquisition_transactions",
        "gross_paid_transactions",
        "reversed_paid_transactions",
        "net_paid_transactions",
        "settled_new_acquisition_amount",
        "gross_payout_amount",
        "net_payout_amount",
        "confirmed_epc",
        "net_payout_epc",
        "exact_faults_passed"
      ],
      "title": "MeasurementReconciliationFacts",
      "type": "object"
    },
    "OperationsEvidence": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "evidence_version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Evidence Version",
          "type": "string"
        },
        "exceptions_total": {
          "minimum": 0,
          "title": "Exceptions Total",
          "type": "integer"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "human_minutes_per_month": {
          "minimum": 0,
          "title": "Human Minutes Per Month",
          "type": "integer"
        },
        "job_runs_succeeded": {
          "minimum": 0,
          "title": "Job Runs Succeeded",
          "type": "integer"
        },
        "job_runs_total": {
          "minimum": 0,
          "title": "Job Runs Total",
          "type": "integer"
        },
        "major_misstatements": {
          "minimum": 0,
          "title": "Major Misstatements",
          "type": "integer"
        },
        "observation_started_at": {
          "format": "date-time",
          "title": "Observation Started At",
          "type": "string"
        },
        "rollback_test_status": {
          "$ref": "#/$defs/RollbackTestStatus"
        },
        "routine_tasks_automated": {
          "minimum": 0,
          "title": "Routine Tasks Automated",
          "type": "integer"
        },
        "routine_tasks_total": {
          "minimum": 0,
          "title": "Routine Tasks Total",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "evidence_version",
        "source_sha256",
        "observation_started_at",
        "captured_at",
        "expires_at",
        "human_minutes_per_month",
        "routine_tasks_total",
        "routine_tasks_automated",
        "major_misstatements",
        "job_runs_total",
        "job_runs_succeeded",
        "exceptions_total",
        "rollback_test_status"
      ],
      "title": "OperationsEvidence",
      "type": "object"
    },
    "RollbackTestStatus": {
      "enum": [
        "not_run",
        "passed",
        "failed"
      ],
      "title": "RollbackTestStatus",
      "type": "string"
    },
    "ScenarioInputs": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/DemandInput"
        },
        "bear": {
          "$ref": "#/$defs/DemandInput"
        },
        "bull": {
          "$ref": "#/$defs/DemandInput"
        }
      },
      "required": [
        "bear",
        "base",
        "bull"
      ],
      "title": "ScenarioInputs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bundle_index_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Index Sha256",
      "type": "string"
    },
    "cohort": {
      "$ref": "#/$defs/CohortEvidence"
    },
    "cohort_attestation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cohort Attestation Sha256",
      "type": "string"
    },
    "country": {
      "const": "JP",
      "default": "JP",
      "title": "Country",
      "type": "string"
    },
    "currency": {
      "const": "JPY",
      "default": "JPY",
      "title": "Currency",
      "type": "string"
    },
    "demand": {
      "$ref": "#/$defs/DemandEvidence"
    },
    "demand_attestation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Demand Attestation Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issuer": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Issuer",
      "type": "string"
    },
    "key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id Sha256",
      "type": "string"
    },
    "language": {
      "const": "ja",
      "default": "ja",
      "title": "Language",
      "type": "string"
    },
    "observation_ended_at": {
      "format": "date-time",
      "title": "Observation Ended At",
      "type": "string"
    },
    "observation_started_at": {
      "format": "date-time",
      "title": "Observation Started At",
      "type": "string"
    },
    "operations": {
      "$ref": "#/$defs/OperationsEvidence"
    },
    "operations_attestation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Operations Attestation Sha256",
      "type": "string"
    },
    "partner_ids": {
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Partner Ids",
      "type": "array"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "property_domain_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Property Domain Sha256",
      "type": "string"
    },
    "property_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Property Record Sha256",
      "type": "string"
    },
    "reconciliation": {
      "$ref": "#/$defs/MeasurementReconciliationFacts"
    },
    "run_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature_base64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature Base64Url",
      "type": "string"
    },
    "signer_role": {
      "const": "tco_qa",
      "title": "Signer Role",
      "type": "string"
    }
  },
  "required": [
    "issuer",
    "key_id_sha256",
    "signer_role",
    "run_id",
    "property_record_sha256",
    "property_domain_sha256",
    "observation_started_at",
    "observation_ended_at",
    "partner_ids",
    "policy_sha256",
    "plan_sha256",
    "bundle_index_sha256",
    "demand_attestation_sha256",
    "cohort_attestation_sha256",
    "operations_attestation_sha256",
    "demand",
    "cohort",
    "operations",
    "reconciliation",
    "issued_at",
    "expires_at",
    "payload_sha256",
    "signature_base64url"
  ],
  "title": "MeasurementIntegrityReport",
  "type": "object"
}

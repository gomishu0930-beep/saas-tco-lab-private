{
  "$defs": {
    "CoveragePartition": {
      "additionalProperties": false,
      "properties": {
        "accepted_records": {
          "minimum": 0,
          "title": "Accepted Records",
          "type": "integer"
        },
        "conflict_records": {
          "minimum": 0,
          "title": "Conflict Records",
          "type": "integer"
        },
        "duplicate_records": {
          "minimum": 0,
          "title": "Duplicate Records",
          "type": "integer"
        },
        "identity_set_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Set Sha256",
          "type": "string"
        },
        "input_records": {
          "minimum": 0,
          "title": "Input Records",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/CoveragePartitionKind"
        },
        "output_records": {
          "minimum": 0,
          "title": "Output Records",
          "type": "integer"
        },
        "rejected_records": {
          "minimum": 0,
          "title": "Rejected Records",
          "type": "integer"
        },
        "unknown_records": {
          "minimum": 0,
          "title": "Unknown Records",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "input_records",
        "accepted_records",
        "rejected_records",
        "duplicate_records",
        "conflict_records",
        "unknown_records",
        "output_records",
        "identity_set_sha256"
      ],
      "title": "CoveragePartition",
      "type": "object"
    },
    "CoveragePartitionKind": {
      "enum": [
        "demand_cluster",
        "qualified_session",
        "valid_outbound_click",
        "affiliate_accepted_click",
        "transaction",
        "status_event",
        "payout_row",
        "payout_adjustment",
        "operation_day",
        "logical_job_run",
        "fault_exercise"
      ],
      "title": "CoveragePartitionKind",
      "type": "string"
    },
    "MeasurementDataset": {
      "enum": [
        "demand",
        "cohort",
        "operations"
      ],
      "title": "MeasurementDataset",
      "type": "string"
    },
    "ProducerCoverage": {
      "additionalProperties": false,
      "properties": {
        "accepted_records": {
          "minimum": 0,
          "title": "Accepted Records",
          "type": "integer"
        },
        "complete_export_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Complete Export Receipt Sha256",
          "type": "string"
        },
        "conflict_records": {
          "minimum": 0,
          "title": "Conflict Records",
          "type": "integer"
        },
        "coverage_rule_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Coverage Rule Sha256",
          "type": "string"
        },
        "duplicate_records": {
          "minimum": 0,
          "title": "Duplicate Records",
          "type": "integer"
        },
        "output_records": {
          "minimum": 0,
          "title": "Output Records",
          "type": "integer"
        },
        "partitions": {
          "items": {
            "$ref": "#/$defs/CoveragePartition"
          },
          "minItems": 1,
          "title": "Partitions",
          "type": "array"
        },
        "privacy_scan_passed": {
          "const": true,
          "title": "Privacy Scan Passed",
          "type": "boolean"
        },
        "privacy_scan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Privacy Scan Sha256",
          "type": "string"
        },
        "raw_records": {
          "minimum": 0,
          "title": "Raw Records",
          "type": "integer"
        },
        "rejected_records": {
          "minimum": 0,
          "title": "Rejected Records",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_export_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Export Sha256",
          "type": "string"
        },
        "unknown_records": {
          "minimum": 0,
          "title": "Unknown Records",
          "type": "integer"
        }
      },
      "required": [
        "source_export_sha256",
        "complete_export_receipt_sha256",
        "coverage_rule_sha256",
        "raw_records",
        "accepted_records",
        "rejected_records",
        "duplicate_records",
        "conflict_records",
        "unknown_records",
        "output_records",
        "partitions",
        "privacy_scan_sha256",
        "privacy_scan_passed"
      ],
      "title": "ProducerCoverage",
      "type": "object"
    },
    "SigningRole": {
      "enum": [
        "controller",
        "tco_qa",
        "human_approver",
        "executor",
        "demand_producer",
        "cohort_producer",
        "operations_producer",
        "measurement_human",
        "measurement_indexer",
        "provider_adapter",
        "provider_probe",
        "integration_evidence_runner",
        "provider_conformance",
        "security_auditor",
        "storage_auditor",
        "time_auditor",
        "network_auditor",
        "recovery_auditor"
      ],
      "title": "SigningRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batch_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Batch Sha256",
      "type": "string"
    },
    "coverage": {
      "$ref": "#/$defs/ProducerCoverage"
    },
    "dataset": {
      "$ref": "#/$defs/MeasurementDataset"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issuer": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Issuer",
      "type": "string"
    },
    "key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id Sha256",
      "type": "string"
    },
    "measurement_version": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Measurement Version",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "property_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Property Record Sha256",
      "type": "string"
    },
    "run_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature_base64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature Base64Url",
      "type": "string"
    },
    "signer_role": {
      "$ref": "#/$defs/SigningRole"
    },
    "source_authority_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Authority Record Sha256",
      "type": "string"
    }
  },
  "required": [
    "dataset",
    "issuer",
    "key_id_sha256",
    "signer_role",
    "run_id",
    "policy_sha256",
    "plan_sha256",
    "property_record_sha256",
    "source_authority_record_sha256",
    "measurement_version",
    "batch_sha256",
    "coverage",
    "issued_at",
    "expires_at",
    "payload_sha256",
    "signature_base64url"
  ],
  "title": "ProducerAttestation",
  "type": "object"
}

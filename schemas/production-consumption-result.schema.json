{
  "$defs": {
    "ActionEnvironment": {
      "enum": [
        "vendor_contact",
        "production"
      ],
      "title": "ActionEnvironment",
      "type": "string"
    },
    "ActionReceipt": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ExternalAction"
        },
        "claim_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Claim Sha256",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/ActionEnvironment"
        },
        "external_action_policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "External Action Policy Sha256",
          "type": "string"
        },
        "grant_payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Grant Payload Sha256",
          "type": "string"
        },
        "idempotency_key_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Idempotency Key Sha256",
          "type": "string"
        },
        "issuer": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Issuer",
          "type": "string"
        },
        "key_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Key Id Sha256",
          "type": "string"
        },
        "observed_post_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observed Post State Sha256",
          "type": "string"
        },
        "observed_pre_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observed Pre State Sha256",
          "type": "string"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "provider_audit_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provider Audit Receipt Sha256",
          "type": "string"
        },
        "provider_operation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provider Operation Sha256",
          "type": "string"

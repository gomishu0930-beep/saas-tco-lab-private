          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/ActionResult"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "const": "executor_action_receipt",
          "default": "executor_action_receipt",
          "title": "Scope",
          "type": "string"
        },
        "signature_base64url": {
          "pattern": "^[A-Za-z0-9_-]{86}$",

        },
        "provenance": {
          "$ref": "#/$defs/ProductionEvidenceProvenance"
        },
        "record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "signature_base64url": {
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "title": "Signature Base64Url",
          "type": "string"
        },
        "signer_role": {
          "const": "provider_probe",
          "default": "provider_probe",
          "title": "Signer Role",
          "type": "string"
        }

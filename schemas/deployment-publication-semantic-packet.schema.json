      "required": [
        "property_record_sha256",
        "environment_identity_sha256",
        "release_identity_sha256",
        "release_manifest_sha256",
        "release_artifact_sha256",
        "deployment_candidate_sha256",
        "production_integration_plan_sha256",
        "provider_target_sha256",
        "expected_pre_state_sha256",
        "independent_readback_evidence_sha256",
        "rollback_disable_evidence_sha256",
        "staged_expected_state_sha256",
        "staged_observed_state_sha256",
        "rollback_active_state_sha256",
        "rollback_expected_state_sha256",
        "rollback_observed_state_sha256"

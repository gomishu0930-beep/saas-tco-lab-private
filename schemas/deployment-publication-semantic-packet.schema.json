{
  "$defs": {
    "AssuranceCheck": {
      "enum": [
        "python_tests",
        "web_local_tests",
        "web_production_tests",
        "schema_determinism",
        "lock_integrity",
        "sbom_current",
        "secret_scan",
        "dependency_audit",
        "threat_model_review",
        "accessibility",
        "mobile_reflow",
        "seo_policy",
        "rollback_faults"
      ],
      "title": "AssuranceCheck",
      "type": "string"
    },
    "AssuranceEvidence": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "assurance_policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assurance Policy Sha256",
          "type": "string"
        },
        "check": {
          "$ref": "#/$defs/AssuranceCheck"
        },
        "command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Sha256",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "facts": {
          "discriminator": {
            "mapping": {
              "determinism": "#/$defs/DeterminismFacts",
              "integrity": "#/$defs/IntegrityFacts",
              "review": "#/$defs/ReviewFacts",
              "route_assurance": "#/$defs/RouteAssuranceFacts",
              "scan": "#/$defs/ScanFacts",
              "test_suite": "#/$defs/TestSuiteFacts"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TestSuiteFacts"
            },
            {
              "$ref": "#/$defs/DeterminismFacts"
            },
            {
              "$ref": "#/$defs/IntegrityFacts"
            },
            {
              "$ref": "#/$defs/ScanFacts"
            },
            {
              "$ref": "#/$defs/ReviewFacts"
            },
            {
              "$ref": "#/$defs/RouteAssuranceFacts"
            }
          ],
          "title": "Facts"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "release_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$",
          "title": "Release Id",
          "type": "string"
        },
        "runner_issuer": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Runner Issuer",
          "type": "string"
        },
        "runner_key_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runner Key Id Sha256",
          "type": "string"
        },
        "runner_role": {
          "const": "controller",
          "default": "controller",
          "title": "Runner Role",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "signature_base64url": {
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "title": "Signature Base64Url",
          "type": "string"
        },
        "subject_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Subject Sha256",
          "type": "string"
        },
        "tool_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "check",
        "release_id",
        "manifest_sha256",
        "artifact_sha256",
        "assurance_policy_sha256",
        "subject_sha256",
        "command_sha256",
        "tool_name",
        "tool_version",
        "facts",
        "observed_at",
        "expires_at",
        "runner_issuer",
        "runner_key_id_sha256",
        "evidence_sha256",
        "signature_base64url"
      ],
      "title": "AssuranceEvidence",
      "type": "object"
    },
    "AssuranceEvidenceBundle": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "assurance_policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assurance Policy Sha256",
          "type": "string"
        },
        "bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/AssuranceEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "release_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$",
          "title": "Release Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "manifest_sha256",
        "artifact_sha256",
        "assurance_policy_sha256",
        "evidence",
        "bundle_sha256"
      ],
      "title": "AssuranceEvidenceBundle",
      "type": "object"
    },
    "AssurancePolicy": {
      "additionalProperties": false,
      "properties": {
        "assurance_runner_key_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assurance Runner Key Id Sha256",
          "type": "string"
        },
        "human_key_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Human Key Id Sha256",
          "type": "string"
        },
        "maximum_attestation_ttl_seconds": {
          "maximum": 604800,
          "minimum": 1,
          "title": "Maximum Attestation Ttl Seconds",
          "type": "integer"
        },
        "maximum_evidence_ttl_seconds": {
          "maximum": 2592000,
          "minimum": 1,
          "title": "Maximum Evidence Ttl Seconds",
          "type": "integer"
        },
        "policy_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$",
          "title": "Policy Id",
          "type": "string"
        },
        "required_local_checks": {
          "default": [
            "accessibility",
            "dependency_audit",
            "lock_integrity",
            "mobile_reflow",
            "python_tests",
            "rollback_faults",
            "sbom_current",
            "schema_determinism",
            "secret_scan",
            "seo_policy",
            "threat_model_review",
            "web_local_tests",
            "web_production_tests"
          ],
          "items": {
            "$ref": "#/$defs/AssuranceCheck"
          },
          "title": "Required Local Checks",
          "type": "array"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/AssuranceRequirement"
          },
          "title": "Requirements",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tco_qa_key_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tco Qa Key Id Sha256",
          "type": "string"
        },
        "trust_store_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trust Store Sha256",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "trust_store_sha256",
        "tco_qa_key_id_sha256",
        "human_key_id_sha256",
        "assurance_runner_key_id_sha256",
        "requirements",
        "maximum_evidence_ttl_seconds",
        "maximum_attestation_ttl_seconds"
      ],
      "title": "AssurancePolicy",
      "type": "object"
    },
    "AssuranceRequirement": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "$ref": "#/$defs/AssuranceCheck"
        },
        "command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Sha256",
          "type": "string"
        },
        "facts_kind": {
          "$ref": "#/$defs/EvidenceFactsKind"
        },
        "subject_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Subject Sha256",
          "type": "string"
        },
        "tool_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "check",
        "facts_kind",
        "tool_name",
        "tool_version",
        "command_sha256",
        "subject_sha256"
      ],
      "title": "AssuranceRequirement",
      "type": "object"
    },
    "ControlTrustStore": {
      "additionalProperties": false,
      "properties": {
        "controller": {
          "$ref": "#/$defs/Ed25519VerificationKey"
        },
        "gold_tco_qa": {
          "$ref": "#/$defs/Ed25519VerificationKey"
        },
        "release_human": {
          "$ref": "#/$defs/Ed25519VerificationKey"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "controller",
        "gold_tco_qa",
        "release_human"
      ],
      "title": "ControlTrustStore",
      "type": "object"
    },
    "DeploymentReadinessFacts": {

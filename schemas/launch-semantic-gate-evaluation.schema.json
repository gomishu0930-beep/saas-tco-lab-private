{
  "$defs": {
    "LaunchSemanticComponent": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/LaunchSemanticComponentKind"
        }
      },
      "required": [
        "kind",
        "artifact_sha256"
      ],
      "title": "LaunchSemanticComponent",
      "type": "object"
    },
    "LaunchSemanticComponentKind": {
      "enum": [
        "rights_decision_record",
        "affiliate_decision_record",
        "qualified_demand_record",
        "shadow_operations_record",
        "gold_source_readiness_record",
        "p15_readiness_report",
        "p15_tco_qa_attestation",
        "p10_local_assurance_report",
        "deployment_readiness_record",
        "publication_readiness_record"
      ],
      "title": "LaunchSemanticComponentKind",
      "type": "string"
    },
    "LaunchSemanticGate": {
      "enum": [
        "rights_approval",
        "affiliate_acceptance",
        "qualified_demand",
        "shadow_operations",
        "gold_set_source_readiness",
        "production_integration_readiness",
        "deployment_publication_readiness"
      ],
      "title": "LaunchSemanticGate",
      "type": "string"
    },
    "LaunchSemanticReason": {
      "enum": [
        "rights_invalid",
        "affiliate_invalid",
        "minimum_vendor_set_not_met",
        "vendor_set_mismatch",
        "scope_mismatch",
        "measurement_invalid",
        "demand_gate_failed",
        "operations_gate_failed",
        "gold_set_invalid",
        "production_readiness_invalid",
        "local_assurance_invalid",
        "deployment_record_invalid",
        "publication_record_invalid",
        "upstream_expiry_invalid"
      ],
      "title": "LaunchSemanticReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/LaunchSemanticComponent"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Components",
      "type": "array"
    },
    "evidence_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Identity Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "gate": {
      "$ref": "#/$defs/LaunchSemanticGate"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "reasons": {
      "items": {
        "$ref": "#/$defs/LaunchSemanticReason"
      },
      "title": "Reasons",
      "type": "array"
    },
    "subject_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Subject Sha256",
      "type": "string"
    }
  },
  "required": [
    "gate",
    "passed",
    "components",
    "evidence_identity_sha256",
    "subject_sha256",
    "reasons",
    "expires_at"
  ],
  "title": "LaunchSemanticGateEvaluation",
  "type": "object"
}

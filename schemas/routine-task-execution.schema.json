{
  "$defs": {
    "RoutineExecutionOutcome": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "RoutineExecutionOutcome",
      "type": "string"
    },
    "RoutineTaskMode": {
      "enum": [
        "automated",
        "manual"
      ],
      "title": "RoutineTaskMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "exception_count": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Exception Count",
      "type": "integer"
    },
    "execution_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Receipt Sha256",
      "type": "string"
    },
    "major_misstatement_count": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Major Misstatement Count",
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/RoutineTaskMode"
    },
    "occurrence_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Occurrence Id Sha256",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/RoutineExecutionOutcome"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "occurrence_id_sha256",
    "execution_receipt_sha256",
    "mode",
    "started_at",
    "completed_at",
    "outcome",
    "exception_count",
    "major_misstatement_count"
  ],
  "title": "RoutineTaskExecution",
  "type": "object"
}

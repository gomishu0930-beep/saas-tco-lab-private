{
  "$defs": {
    "AssuranceCheck": {
      "enum": [
        "python_tests",
        "web_local_tests",
        "web_production_tests",
        "schema_determinism",
        "lock_integrity",
        "sbom_current",
        "secret_scan",
        "dependency_audit",
        "threat_model_review",
        "accessibility",
        "mobile_reflow",
        "seo_policy",
        "rollback_faults"
      ],
      "title": "AssuranceCheck",
      "type": "string"
    },
    "EvidenceFactsKind": {
      "enum": [
        "test_suite",
        "determinism",
        "integrity",
        "scan",
        "review",
        "route_assurance"
      ],
      "title": "EvidenceFactsKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "check": {
      "$ref": "#/$defs/AssuranceCheck"
    },
    "command_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "facts_kind": {
      "$ref": "#/$defs/EvidenceFactsKind"
    },
    "subject_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Subject Sha256",
      "type": "string"
    },
    "tool_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Tool Name",
      "type": "string"
    },
    "tool_version": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "check",
    "facts_kind",
    "tool_name",
    "tool_version",
    "command_sha256",
    "subject_sha256"
  ],
  "title": "AssuranceRequirement",
  "type": "object"
}

{
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issuer": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Issuer",
      "type": "string"
    },
    "key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id Sha256",
      "type": "string"
    },
    "nonce_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Nonce Sha256",
      "type": "string"
    },
    "not_before": {
      "format": "date-time",
      "title": "Not Before",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "reconciliation_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reconciliation Record Sha256",
      "type": "string"
    },
    "remediation_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Remediation Record Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "global_stop_reset",
      "default": "global_stop_reset",
      "title": "Scope",
      "type": "string"
    },
    "signature_base64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature Base64Url",
      "type": "string"
    },
    "signer_role": {
      "const": "human_approver",
      "default": "human_approver",
      "title": "Signer Role",
      "type": "string"
    },
    "stop_reason_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Stop Reason Sha256",
      "type": "string"
    },
    "stopped_epoch": {
      "minimum": 0,
      "title": "Stopped Epoch",
      "type": "integer"
    },
    "stopped_head_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Stopped Head Sha256",
      "type": "string"
    },
    "stopped_revision": {
      "minimum": 0,
      "title": "Stopped Revision",
      "type": "integer"
    },
    "store_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Store Id Sha256",
      "type": "string"
    }
  },
  "required": [
    "issuer",
    "key_id_sha256",
    "store_id_sha256",
    "policy_sha256",
    "stopped_epoch",
    "stopped_revision",
    "stopped_head_sha256",
    "stop_reason_sha256",
    "remediation_record_sha256",
    "reconciliation_record_sha256",
    "nonce_sha256",
    "issued_at",
    "not_before",
    "expires_at",
    "payload_sha256",
    "signature_base64url"
  ],
  "title": "HumanGlobalStopReset",
  "type": "object"
}

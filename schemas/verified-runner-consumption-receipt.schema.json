          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "store_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Store Id Sha256",
          "type": "string"
        }
      },
      "required": [
        "store_id_sha256",
        "expected_sequence",
        "expected_previous_evidence_head_sha256",
        "challenge_sha256",
        "evidence_bundle_sha256",
        "authority_sha256",
        "request_nonce_sha256",
        "request_sha256"
      ],
      "title": "VerifiedRunnerConsumerClockRequest",
      "type": "object"
    }

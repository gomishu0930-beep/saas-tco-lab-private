{
  "additionalProperties": false,
  "properties": {
    "maximum_evidence_ttl_seconds": {
      "maximum": 31536000,
      "minimum": 1,
      "title": "Maximum Evidence Ttl Seconds",
      "type": "integer"
    },
    "maximum_live_gate_ttl_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "title": "Maximum Live Gate Ttl Seconds",
      "type": "integer"
    },
    "maximum_plan_ttl_seconds": {
      "maximum": 31536000,
      "minimum": 1,
      "title": "Maximum Plan Ttl Seconds",
      "type": "integer"
    },
    "maximum_report_ttl_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "title": "Maximum Report Ttl Seconds",
      "type": "integer"
    },
    "policy_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "const": "3.0",
      "default": "3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trust_store_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trust Store Sha256",
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "trust_store_sha256",
    "maximum_plan_ttl_seconds",
    "maximum_evidence_ttl_seconds",
    "maximum_live_gate_ttl_seconds",
    "maximum_report_ttl_seconds"
  ],
  "title": "LaunchHandoffPolicy",
  "type": "object"
}

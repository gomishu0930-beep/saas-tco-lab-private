{
  "additionalProperties": false,
  "properties": {
    "decision_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decision Record Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issuer": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$",
      "title": "Issuer",
      "type": "string"
    },
    "key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id Sha256",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "release_event_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Release Event Sha256",
      "type": "string"
    },
    "release_id": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$",
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "current_release_decision",
      "default": "current_release_decision",
      "title": "Scope",
      "type": "string"
    },
    "signature_base64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature Base64Url",
      "type": "string"
    },
    "signer_role": {
      "const": "human_approver",
      "default": "human_approver",
      "title": "Signer Role",
      "type": "string"
    }
  },
  "required": [
    "issuer",
    "key_id_sha256",
    "release_id",
    "manifest_sha256",
    "release_event_sha256",
    "decision_record_sha256",
    "issued_at",
    "expires_at",
    "payload_sha256",
    "signature_base64url"
  ],
  "title": "ReleaseDecisionAttestation",
  "type": "object"
}

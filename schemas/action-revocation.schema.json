{
  "additionalProperties": false,
  "properties": {
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "external_action_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "External Action Policy Sha256",
      "type": "string"
    },
    "grant_payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Grant Payload Sha256",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issuer": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Issuer",
      "type": "string"
    },
    "key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id Sha256",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "reason_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reason Record Sha256",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "controller_grant_revocation",
      "default": "controller_grant_revocation",
      "title": "Scope",
      "type": "string"
    },
    "signature_base64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature Base64Url",
      "type": "string"
    },
    "signer_role": {
      "const": "controller",
      "default": "controller",
      "title": "Signer Role",
      "type": "string"
    }
  },
  "required": [
    "issuer",
    "key_id_sha256",
    "request_sha256",
    "grant_payload_sha256",
    "external_action_policy_sha256",
    "reason_record_sha256",
    "issued_at",
    "effective_at",
    "payload_sha256",
    "signature_base64url"
  ],
  "title": "ActionRevocation",
  "type": "object"
}

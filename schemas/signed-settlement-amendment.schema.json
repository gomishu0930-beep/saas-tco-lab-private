{
  "$defs": {
    "PayoutAdjustmentKind": {
      "enum": [
        "refund",
        "chargeback"
      ],
      "title": "PayoutAdjustmentKind",
      "type": "string"
    },
    "SettlementPayoutAdjustment": {
      "additionalProperties": false,
      "properties": {
        "adjustment_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adjustment Id Sha256",
          "type": "string"
        },
        "adjustment_kind": {
          "$ref": "#/$defs/PayoutAdjustmentKind"
        },
        "amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,25}0*$)\\d{0,16}\\.\\d{0,8}0*$)",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "effective_at": {
          "format": "date-time",
          "title": "Effective At",
          "type": "string"
        },
        "event_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Id Sha256",
          "type": "string"
        },
        "kind": {
          "const": "payout_adjustment",
          "default": "payout_adjustment",
          "title": "Kind",
          "type": "string"
        },
        "original_transaction_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Transaction Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_row_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Row Sha256",
          "type": "string"
        },
        "transaction_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Transaction Id Sha256",
          "type": "string"
        }
      },
      "required": [
        "event_id_sha256",
        "transaction_id_sha256",
        "original_transaction_sha256",
        "adjustment_id_sha256",
        "adjustment_kind",
        "amount",
        "currency",
        "source_row_sha256",
        "effective_at"
      ],
      "title": "SettlementPayoutAdjustment",
      "type": "object"
    },
    "SettlementStatusChange": {
      "additionalProperties": false,
      "properties": {
        "current_status": {
          "$ref": "#/$defs/TransactionStatus"
        },
        "effective_at": {
          "format": "date-time",
          "title": "Effective At",
          "type": "string"
        },
        "event_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Id Sha256",
          "type": "string"
        },
        "kind": {
          "const": "status_change",
          "default": "status_change",
          "title": "Kind",
          "type": "string"
        },
        "original_transaction_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Transaction Sha256",
          "type": "string"
        },
        "previous_status": {
          "$ref": "#/$defs/TransactionStatus"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_row_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Row Sha256",
          "type": "string"
        },
        "transaction_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Transaction Id Sha256",
          "type": "string"
        }
      },
      "required": [
        "event_id_sha256",
        "transaction_id_sha256",
        "original_transaction_sha256",
        "previous_status",
        "current_status",
        "source_row_sha256",
        "effective_at"
      ],
      "title": "SettlementStatusChange",
      "type": "object"
    },
    "TransactionStatus": {
      "enum": [
        "pending",
        "rejected",
        "confirmed",
        "paid",
        "refunded",
        "charged_back"
      ],
      "title": "TransactionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "amendment_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Amendment Id Sha256",
      "type": "string"
    },
    "cohort_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Cohort Id",
      "type": "string"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "event_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Event Root Sha256",
      "type": "string"
    },
    "events": {
      "default": [],
      "items": {
        "discriminator": {
          "mapping": {
            "payout_adjustment": "#/$defs/SettlementPayoutAdjustment",
            "status_change": "#/$defs/SettlementStatusChange"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SettlementStatusChange"
          },
          {
            "$ref": "#/$defs/SettlementPayoutAdjustment"
          }
        ]
      },
      "title": "Events",
      "type": "array"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issuer": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Issuer",
      "type": "string"
    },
    "key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id Sha256",
      "type": "string"
    },
    "observed_through_at": {
      "format": "date-time",
      "title": "Observed Through At",
      "type": "string"
    },
    "original_binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Original Binding Sha256",
      "type": "string"
    },
    "partner_ids": {
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Partner Ids",
      "type": "array"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "property_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Property Record Sha256",
      "type": "string"
    },
    "run_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature_base64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature Base64Url",
      "type": "string"
    },
    "signer_role": {
      "const": "cohort_producer",
      "title": "Signer Role",
      "type": "string"
    }
  },
  "required": [
    "issuer",
    "key_id_sha256",
    "signer_role",
    "amendment_id_sha256",
    "policy_sha256",
    "original_binding_sha256",
    "run_id",
    "cohort_id",
    "property_record_sha256",
    "partner_ids",
    "currency",
    "event_root_sha256",
    "observed_through_at",
    "issued_at",
    "expires_at",
    "payload_sha256",
    "signature_base64url"
  ],
  "title": "SignedSettlementAmendment",
  "type": "object"
}

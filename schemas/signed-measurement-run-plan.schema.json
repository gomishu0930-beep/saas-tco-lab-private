{
  "$defs": {
    "FaultId": {
      "enum": [
        "fi-01-price-change",
        "fi-02-plan-rename",
        "fi-03-billing-period-change",
        "fi-04-currency-change",
        "fi-05-quota-overage-change",
        "fi-06-source-conflict",
        "fi-07-affiliate-expiry",
        "fi-08-fetch-failure-duplicate-delivery"
      ],
      "title": "FaultId",
      "type": "string"
    },
    "FaultRequirement": {
      "additionalProperties": false,
      "properties": {
        "definition_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Definition Sha256",
          "type": "string"
        },
        "fault_id": {
          "$ref": "#/$defs/FaultId"
        }
      },
      "required": [
        "fault_id",
        "definition_sha256"
      ],
      "title": "FaultRequirement",
      "type": "object"
    },
    "MeasurementRulePins": {
      "additionalProperties": false,
      "properties": {
        "attribution_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Attribution Sha256",
          "type": "string"
        },
        "coverage_completeness_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Coverage Completeness Sha256",
          "type": "string"
        },
        "demand_deduplication_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Demand Deduplication Sha256",
          "type": "string"
        },
        "event_deduplication_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Deduplication Sha256",
          "type": "string"
        },
        "exception_deduplication_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Exception Deduplication Sha256",
          "type": "string"
        },
        "fault_catalog_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fault Catalog Sha256",
          "type": "string"
        },
        "human_time_union_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Human Time Union Sha256",
          "type": "string"
        },
        "job_schedule_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Job Schedule Sha256",
          "type": "string"
        },
        "job_status_mapping_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Job Status Mapping Sha256",
          "type": "string"
        },
        "new_acquisition_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "New Acquisition Sha256",
          "type": "string"
        },
        "payout_reconciliation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payout Reconciliation Sha256",
          "type": "string"
        },
        "privacy_minimization_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Privacy Minimization Sha256",
          "type": "string"
        },
        "qa_policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Qa Policy Sha256",
          "type": "string"
        },
        "qualification_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Qualification Sha256",
          "type": "string"
        },
        "refund_chargeback_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Refund Chargeback Sha256",
          "type": "string"
        },
        "retry_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Retry Identity Sha256",
          "type": "string"
        },
        "routine_inventory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Routine Inventory Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Session Identity Sha256",
          "type": "string"
        },
        "status_transition_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Status Transition Sha256",
          "type": "string"
        },
        "transaction_deduplication_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Transaction Deduplication Sha256",
          "type": "string"
        },
        "valid_outbound_filter_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Valid Outbound Filter Sha256",
          "type": "string"
        }
      },
      "required": [
        "qualification_sha256",
        "session_identity_sha256",
        "demand_deduplication_sha256",
        "valid_outbound_filter_sha256",
        "event_deduplication_sha256",
        "attribution_sha256",
        "transaction_deduplication_sha256",
        "status_transition_sha256",
        "refund_chargeback_sha256",
        "new_acquisition_sha256",
        "payout_reconciliation_sha256",
        "routine_inventory_sha256",
        "job_schedule_sha256",
        "job_status_mapping_sha256",
        "retry_identity_sha256",
        "exception_deduplication_sha256",
        "human_time_union_sha256",
        "qa_policy_sha256",
        "fault_catalog_sha256",
        "privacy_minimization_sha256",
        "coverage_completeness_sha256"
      ],
      "title": "MeasurementRulePins",
      "type": "object"
    },
    "MeasurementRunDefinition": {
      "additionalProperties": false,
      "properties": {
        "business_timezone": {
          "const": "Asia/Tokyo",
          "default": "Asia/Tokyo",
          "title": "Business Timezone",
          "type": "string"
        },
        "cohort_authority_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cohort Authority Record Sha256",
          "type": "string"
        },
        "cohort_measurement_version": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Cohort Measurement Version",
          "type": "string"
        },
        "country": {
          "const": "JP",
          "default": "JP",
          "title": "Country",
          "type": "string"
        },
        "currency": {
          "const": "JPY",
          "default": "JPY",
          "title": "Currency",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/RunFreezeDecision"
        },
        "demand_authority_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Demand Authority Record Sha256",
          "type": "string"
        },
        "demand_measurement_version": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Demand Measurement Version",
          "type": "string"
        },
        "fault_requirements": {
          "items": {
            "$ref": "#/$defs/FaultRequirement"
          },
          "maxItems": 8,
          "minItems": 8,
          "title": "Fault Requirements",
          "type": "array"
        },
        "fault_target_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fault Target Artifact Sha256",
          "type": "string"
        },
        "fault_target_release_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fault Target Release Sha256",
          "type": "string"
        },
        "fault_target_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fault Target Schema Sha256",
          "type": "string"
        },
        "language": {
          "const": "ja",
          "default": "ja",
          "title": "Language",
          "type": "string"
        },
        "observation_ended_at": {
          "format": "date-time",
          "title": "Observation Ended At",
          "type": "string"
        },
        "observation_started_at": {
          "format": "date-time",
          "title": "Observation Started At",
          "type": "string"
        },
        "operations_authority_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Operations Authority Record Sha256",
          "type": "string"
        },
        "operations_measurement_version": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Operations Measurement Version",
          "type": "string"
        },
        "partner_ids": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Partner Ids",
          "type": "array"
        },
        "planned_logical_job_count": {
          "minimum": 1,
          "title": "Planned Logical Job Count",
          "type": "integer"
        },
        "planned_logical_job_set_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Planned Logical Job Set Sha256",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "property_domain_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Property Domain Sha256",
          "type": "string"
        },
        "property_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Property Record Sha256",
          "type": "string"
        },
        "rules": {
          "$ref": "#/$defs/MeasurementRulePins"
        },
        "run_id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_month": {
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$",
          "title": "Source Month",
          "type": "string"
        },
        "trust_store_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trust Store Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "decision",
        "policy_sha256",
        "trust_store_sha256",
        "property_record_sha256",
        "property_domain_sha256",
        "source_month",
        "observation_started_at",
        "observation_ended_at",
        "partner_ids",
        "demand_measurement_version",
        "cohort_measurement_version",
        "operations_measurement_version",
        "demand_authority_record_sha256",
        "cohort_authority_record_sha256",
        "operations_authority_record_sha256",
        "planned_logical_job_count",
        "planned_logical_job_set_sha256",
        "fault_target_release_sha256",
        "fault_target_artifact_sha256",
        "fault_target_schema_sha256",
        "rules",
        "fault_requirements"
      ],
      "title": "MeasurementRunDefinition",
      "type": "object"
    },
    "RunFreezeDecision": {
      "enum": [
        "go",
        "hold",
        "stop"
      ],
      "title": "RunFreezeDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "definition": {
      "$ref": "#/$defs/MeasurementRunDefinition"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issuer": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Issuer",
      "type": "string"
    },
    "key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id Sha256",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature_base64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature Base64Url",
      "type": "string"
    },
    "signer_role": {
      "const": "measurement_human",
      "title": "Signer Role",
      "type": "string"
    }
  },
  "required": [
    "definition",
    "issuer",
    "key_id_sha256",
    "signer_role",
    "issued_at",
    "expires_at",
    "payload_sha256",
    "signature_base64url"
  ],
  "title": "SignedMeasurementRunPlan",
  "type": "object"
}

{
  "$defs": {
    "AddressableDemandStatus": {
      "enum": [
        "unknown_headword_concentrated",
        "not_separated_by_concentration",
        "unknown_insufficient_evidence",
        "unknown_reexport_required"
      ],
      "title": "AddressableDemandStatus",
      "type": "string"
    },
    "DemandCapacityDecision": {
      "enum": [
        "insufficient_even_at_full_capture",
        "known_volume_floor_below_required_incomplete",
        "volume_floor_met_not_proven"
      ],
      "title": "DemandCapacityDecision",
      "type": "string"
    },
    "HeadwordConcentrationStatus": {
      "enum": [
        "high",
        "not_high",
        "insufficient_known_rows",
        "not_recomputable_from_safe_summary"
      ],
      "title": "HeadwordConcentrationStatus",
      "type": "string"
    },
    "MangoolsSlateDemandSafeSummary": {
      "additionalProperties": false,
      "description": "Safe aggregate for one frozen variable-length query slate.",
      "properties": {
        "acquisition_method": {
          "const": "human_ui_export",
          "default": "human_ui_export",
          "title": "Acquisition Method",
          "type": "string"
        },
        "addressable_demand_status": {
          "$ref": "#/$defs/AddressableDemandStatus",
          "default": "unknown_reexport_required"
        },
        "assumed_confirmed_epc_jpy": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,8}0*$",
              "type": "string"
            }
          ],
          "title": "Assumed Confirmed Epc Jpy"
        },
        "assumed_outbound_ctr": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,8}0*$",
              "type": "string"
            }
          ],
          "title": "Assumed Outbound Ctr"
        },
        "capacity_decision": {
          "$ref": "#/$defs/DemandCapacityDecision"
        },
        "comma_integer_volume_count": {
          "maximum": 200,
          "minimum": 0,
          "title": "Comma Integer Volume Count",
          "type": "integer"
        },
        "country": {
          "const": "JP",
          "default": "JP",
          "title": "Country",
          "type": "string"
        },
        "decimal_volume_count": {
          "maximum": 200,
          "minimum": 0,
          "title": "Decimal Volume Count",
          "type": "integer"
        },
        "frozen_universe_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Frozen Universe Sha256",
          "type": "string"
        },
        "headword_concentration_rule": {
          "const": "top2_gte_0_50_or_top5_gte_0_80",
          "default": "top2_gte_0_50_or_top5_gte_0_80",
          "title": "Headword Concentration Rule",
          "type": "string"
        },
        "headword_concentration_status": {
          "$ref": "#/$defs/HeadwordConcentrationStatus",
          "default": "not_recomputable_from_safe_summary"
        },
        "integer_volume_count": {
          "maximum": 200,
          "minimum": 0,
          "title": "Integer Volume Count",
          "type": "integer"
        },
        "keyword_count": {
          "maximum": 200,
          "minimum": 1,
          "title": "Keyword Count",
          "type": "integer"
        },
        "known_monthly_search_volume_total": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Known Monthly Search Volume Total"
        },
        "known_volume_count": {
          "maximum": 200,
          "minimum": 0,
          "title": "Known Volume Count",
          "type": "integer"
        },
        "language": {
          "const": "ja",
          "default": "ja",
          "title": "Language",
          "type": "string"
        },
        "monthly_revenue_target_jpy": {
          "exclusiveMinimum": 0,
          "title": "Monthly Revenue Target Jpy",
          "type": "integer"
        },
        "next_review_on": {
          "format": "date",
          "title": "Next Review On",
          "type": "string"
        },
        "no_data_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,8}0*$",
              "type": "string"
            }
          ],
          "title": "No Data Rate"
        },
        "no_data_volume_count": {
          "maximum": 200,
          "minimum": 0,
          "title": "No Data Volume Count",
          "type": "integer"
        },
        "observed_on": {
          "format": "date",
          "title": "Observed On",
          "type": "string"
        },
        "provider": {
          "const": "mangools_kwfinder_human_csv",
          "default": "mangools_kwfinder_human_csv",
          "title": "Provider",
          "type": "string"
        },
        "query_values_saved": {
          "const": false,
          "default": false,
          "title": "Query Values Saved",
          "type": "boolean"
        },
        "raw_csv_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Raw Csv Sha256",
          "type": "array"
        },
        "raw_saved": {
          "const": false,
          "default": false,
          "title": "Raw Saved",
          "type": "boolean"
        },
        "rejected_rows": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MangoolsSlateRejectedVolumeRow"
          },
          "title": "Rejected Rows",
          "type": "array"
        },
        "rejected_volume_count": {
          "maximum": 200,
          "minimum": 0,
          "title": "Rejected Volume Count",
          "type": "integer"
        },
        "required_confirmed_outbound_clicks": {
          "exclusiveMinimum": 0,
          "title": "Required Confirmed Outbound Clicks",
          "type": "integer"
        },
        "required_sessions_at_assumed_ctr": {
          "exclusiveMinimum": 0,
          "title": "Required Sessions At Assumed Ctr",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.1",
          "default": "1.1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_expansion_recommended": {
          "title": "Scope Expansion Recommended",
          "type": "boolean"
        },
        "slate_id": {
          "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$",
          "title": "Slate Id",
          "type": "string"
        },
        "source_file_count": {
          "maximum": 20,
          "minimum": 1,
          "title": "Source File Count",
          "type": "integer"
        },
        "top_2_known_volume_share": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,8}0*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top 2 Known Volume Share"
        },
        "top_5_known_volume_share": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,8}0*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top 5 Known Volume Share"
        }
      },
      "required": [
        "slate_id",
        "source_file_count",
        "keyword_count",
        "known_volume_count",
        "no_data_volume_count",
        "rejected_volume_count",
        "integer_volume_count",
        "comma_integer_volume_count",
        "decimal_volume_count",
        "known_monthly_search_volume_total",
        "no_data_rate",
        "observed_on",
        "next_review_on",
        "raw_csv_sha256",
        "frozen_universe_sha256",
        "monthly_revenue_target_jpy",
        "assumed_confirmed_epc_jpy",
        "assumed_outbound_ctr",
        "required_confirmed_outbound_clicks",
        "required_sessions_at_assumed_ctr",
        "capacity_decision",
        "scope_expansion_recommended"
      ],
      "title": "MangoolsSlateDemandSafeSummary",
      "type": "object"
    },
    "MangoolsSlateRejectedVolumeRow": {
      "additionalProperties": false,
      "properties": {
        "batch_number": {
          "minimum": 1,
          "title": "Batch Number",
          "type": "integer"
        },
        "line_number": {
          "minimum": 2,
          "title": "Line Number",
          "type": "integer"
        },
        "source_text": {
          "title": "Source Text",
          "type": "string"
        }
      },
      "required": [
        "batch_number",
        "line_number",
        "source_text"
      ],
      "title": "MangoolsSlateRejectedVolumeRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Safe aggregate envelope for the four remaining expansion slates.",
  "properties": {
    "acquisition_method": {
      "const": "human_ui_export",
      "default": "human_ui_export",
      "title": "Acquisition Method",
      "type": "string"
    },
    "all_complete": {
      "const": true,
      "default": true,
      "title": "All Complete",
      "type": "boolean"
    },
    "known_monthly_search_volume_total": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Known Monthly Search Volume Total"
    },
    "next_review_on": {
      "format": "date",
      "title": "Next Review On",
      "type": "string"
    },
    "observed_on": {
      "format": "date",
      "title": "Observed On",
      "type": "string"
    },
    "provider": {
      "const": "mangools_kwfinder_human_csv",
      "default": "mangools_kwfinder_human_csv",
      "title": "Provider",
      "type": "string"
    },
    "query_values_saved": {
      "const": false,
      "default": false,
      "title": "Query Values Saved",
      "type": "boolean"
    },
    "raw_saved": {
      "const": false,
      "default": false,
      "title": "Raw Saved",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "slate_ids": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "const": "crm",
          "type": "string"
        },
        {
          "const": "forms",
          "type": "string"
        },
        {
          "const": "email_marketing",
          "type": "string"
        },
        {
          "const": "seo_tools_v2_extension",
          "type": "string"
        }
      ],
      "title": "Slate Ids",
      "type": "array"
    },
    "summaries": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/MangoolsSlateDemandSafeSummary"
        },
        {
          "$ref": "#/$defs/MangoolsSlateDemandSafeSummary"
        },
        {
          "$ref": "#/$defs/MangoolsSlateDemandSafeSummary"
        },
        {
          "$ref": "#/$defs/MangoolsSlateDemandSafeSummary"
        }
      ],
      "title": "Summaries",
      "type": "array"
    },
    "total_keyword_count": {
      "const": 180,
      "title": "Total Keyword Count",
      "type": "integer"
    },
    "total_known_volume_count": {
      "maximum": 180,
      "minimum": 0,
      "title": "Total Known Volume Count",
      "type": "integer"
    },
    "total_no_data_volume_count": {
      "maximum": 180,
      "minimum": 0,
      "title": "Total No Data Volume Count",
      "type": "integer"
    },
    "total_rejected_volume_count": {
      "maximum": 180,
      "minimum": 0,
      "title": "Total Rejected Volume Count",
      "type": "integer"
    }
  },
  "required": [
    "slate_ids",
    "summaries",
    "total_keyword_count",
    "total_known_volume_count",
    "total_no_data_volume_count",
    "total_rejected_volume_count",
    "known_monthly_search_volume_total",
    "observed_on",
    "next_review_on"
  ],
  "title": "MangoolsExpansionSetSafeSummary",
  "type": "object"
}

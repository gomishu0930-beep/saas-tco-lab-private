{
  "$defs": {
    "StrategyPosture": {
      "enum": [
        "conservative",
        "balanced",
        "aggressive"
      ],
      "title": "StrategyPosture",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "eligible": {
      "title": "Eligible",
      "type": "boolean"
    },
    "expected_value_of_information": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expected Value Of Information"
    },
    "hard_gate_failures": {
      "items": {
        "type": "string"
      },
      "title": "Hard Gate Failures",
      "type": "array"
    },
    "posture": {
      "$ref": "#/$defs/StrategyPosture"
    },
    "proposal_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Id Sha256",
      "type": "string"
    }
  },
  "required": [
    "proposal_id_sha256",
    "posture",
    "eligible",
    "expected_value_of_information",
    "hard_gate_failures"
  ],
  "title": "InitiativeAssessment",
  "type": "object"
}

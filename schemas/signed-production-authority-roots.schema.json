{
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issuer": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Issuer",
      "type": "string"
    },
    "key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id Sha256",
      "type": "string"
    },
    "launch_handoff_authority_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Launch Handoff Authority Sha256",
      "type": "string"
    },
    "launch_semantic_authority_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Launch Semantic Authority Sha256",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "repository_acceptance_authority_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Repository Acceptance Authority Sha256",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "revision": {
      "maximum": 1000000000,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature_base64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature Base64Url",
      "type": "string"
    },
    "signer_role": {
      "const": "storage_auditor",
      "default": "storage_auditor",
      "title": "Signer Role",
      "type": "string"
    }
  },
  "required": [
    "request_sha256",
    "revision",
    "repository_acceptance_authority_sha256",
    "launch_handoff_authority_sha256",
    "launch_semantic_authority_sha256",
    "observed_at",
    "issued_at",
    "expires_at",
    "issuer",
    "key_id_sha256",
    "payload_sha256",
    "signature_base64url"

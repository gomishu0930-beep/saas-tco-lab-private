{
  "additionalProperties": false,
  "properties": {
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "cohort_attestation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cohort Attestation Sha256",
      "type": "string"
    },
    "cohort_batch_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cohort Batch Sha256",
      "type": "string"
    },
    "demand_attestation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Demand Attestation Sha256",
      "type": "string"
    },
    "demand_batch_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Demand Batch Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issuer": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Issuer",
      "type": "string"
    },
    "key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id Sha256",
      "type": "string"
    },
    "operations_attestation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Operations Attestation Sha256",
      "type": "string"
    },
    "operations_batch_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Operations Batch Sha256",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "property_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Property Record Sha256",
      "type": "string"
    },
    "run_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature_base64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature Base64Url",
      "type": "string"
    },
    "signer_role": {
      "const": "measurement_indexer",
      "title": "Signer Role",
      "type": "string"
    }
  },
  "required": [
    "issuer",
    "key_id_sha256",
    "signer_role",
    "run_id",
    "policy_sha256",
    "plan_sha256",
    "property_record_sha256",
    "demand_batch_sha256",
    "cohort_batch_sha256",
    "operations_batch_sha256",
    "demand_attestation_sha256",
    "cohort_attestation_sha256",
    "operations_attestation_sha256",
    "captured_at",
    "issued_at",
    "expires_at",
    "payload_sha256",
    "signature_base64url"
  ],
  "title": "MeasurementBundleIndex",
  "type": "object"
}

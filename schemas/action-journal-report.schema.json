{
  "$defs": {
    "JournalAuthorityState": {
      "enum": [
        "granted",
        "claimed",
        "expired",
        "revoked"
      ],
      "title": "JournalAuthorityState",
      "type": "string"
    },
    "JournalOutcomeState": {
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "partial",
        "unknown"
      ],
      "title": "JournalOutcomeState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority_state": {
      "$ref": "#/$defs/JournalAuthorityState"
    },
    "entry_count": {
      "minimum": 1,
      "title": "Entry Count",
      "type": "integer"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "grant_payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Grant Payload Sha256",
      "type": "string"
    },
    "head_entry_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Head Entry Sha256",
      "type": "string"
    },
    "journal_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Journal Id",
      "type": "string"
    },
    "outcome_state": {
      "$ref": "#/$defs/JournalOutcomeState"
    },
    "receipt_payload_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Receipt Payload Sha256"
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "revocation_payload_sha256s": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Revocation Payload Sha256S",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state_anchor_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "State Anchor Sha256",
      "type": "string"
    },
    "state_revision": {
      "minimum": 0,
      "title": "State Revision",
      "type": "integer"
    },
    "state_store_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "State Store Id Sha256",
      "type": "string"
    }
  },
  "required": [
    "journal_id",
    "request_sha256",
    "grant_payload_sha256",
    "state_store_id_sha256",
    "state_revision",
    "state_anchor_sha256",
    "authority_state",
    "outcome_state",
    "entry_count",
    "head_entry_sha256",
    "receipt_payload_sha256",
    "revocation_payload_sha256s",
    "evaluated_at",
    "report_sha256"
  ],
  "title": "ActionJournalReport",
  "type": "object"
}

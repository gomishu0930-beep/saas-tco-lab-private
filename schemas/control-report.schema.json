{
  "$defs": {
    "BudgetStatus": {
      "enum": [
        "normal",
        "frozen",
        "exhausted"
      ],
      "title": "BudgetStatus",
      "type": "string"
    },
    "ControlDecision": {
      "enum": [
        "stop",
        "hold",
        "human_approval_required",
        "maintain_current"
      ],
      "title": "ControlDecision",
      "type": "string"
    },
    "ControlReason": {
      "enum": [
        "config_invalid",
        "trust_store_invalid",
        "trust_store_mismatch",
        "controller_key_invalid",
        "business_stop",
        "business_continue",
        "dossier_invalid",
        "gold_report_invalid",
        "gold_report_future",
        "gold_report_stale",
        "gold_not_ready",
        "gold_attestation_invalid",
        "parser_failure_stop",
        "rights_binding_mismatch",
        "affiliate_binding_mismatch",
        "candidate_binding_mismatch",
        "heartbeat_invalid",
        "heartbeat_future",
        "heartbeat_stale",
        "scheduler_interval_exceeded",
        "scheduler_lag",
        "open_sev0",
        "open_sev1",
        "budget_month_mismatch",
        "budget_exhausted",
        "no_current_release",
        "release_future",
        "release_hidden",
        "release_attestation_invalid",
        "lease_deadline_reached"
      ],
      "title": "ControlReason",
      "type": "string"
    },
    "Decision": {
      "enum": [
        "go",
        "continue",
        "stop"
      ],
      "title": "Decision",
      "type": "string"
    },
    "ServingLease": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "control_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Control Input Sha256",
          "type": "string"
        },
        "controller_key_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Controller Key Id Sha256",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "issuer": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$",
          "title": "Issuer",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "release_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$",
          "title": "Release Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "const": "serve_protected_content",
          "default": "serve_protected_content",
          "title": "Scope",
          "type": "string"
        },
        "signature_base64url": {
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "title": "Signature Base64Url",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "controller_key_id_sha256",
        "control_input_sha256",
        "release_id",
        "manifest_sha256",
        "artifact_sha256",
        "issued_at",
        "expires_at",
        "payload_sha256",
        "signature_base64url"
      ],
      "title": "ServingLease",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/BudgetStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "business_decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Decision"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Artifact Sha256"
    },
    "current_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Manifest Sha256"
    },
    "current_release_id": {
      "anyOf": [
        {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Release Id"
    },
    "decision": {
      "$ref": "#/$defs/ControlDecision"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "gold_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Gold Report Sha256",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "reasons": {
      "items": {
        "$ref": "#/$defs/ControlReason"
      },
      "title": "Reasons",
      "type": "array"
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "serving_lease": {
      "anyOf": [
        {
          "$ref": "#/$defs/ServingLease"
        },
        {
          "type": "null"
        }
      ]
    },
    "unresolved_sev0_count": {
      "minimum": 0,
      "title": "Unresolved Sev0 Count",
      "type": "integer"
    },
    "unresolved_sev1_count": {
      "minimum": 0,
      "title": "Unresolved Sev1 Count",
      "type": "integer"
    }
  },
  "required": [
    "decision",
    "evaluated_at",
    "input_sha256",
    "reasons",
    "business_decision",
    "gold_report_sha256",
    "budget_status",
    "unresolved_sev0_count",
    "unresolved_sev1_count",
    "current_manifest_sha256",
    "current_artifact_sha256",
    "serving_lease",
    "report_sha256"
  ],
  "title": "ControlReport",
  "type": "object"
}

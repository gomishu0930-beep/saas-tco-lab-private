{
  "$defs": {
    "ApprovalDecision": {
      "enum": [
        "go",
        "stop",
        "conditional"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approved_data_snapshot_sha256s": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Approved Data Snapshot Sha256S",
      "type": "array"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "assurance_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Assurance Policy Sha256",
      "type": "string"
    },
    "business_dossier_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Business Dossier Sha256",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ApprovalDecision"
    },
    "decision_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decision Record Sha256",
      "type": "string"
    },
    "evidence_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Bundle Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issuer": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Issuer",
      "type": "string"
    },
    "key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id Sha256",
      "type": "string"
    },
    "local_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Local Report Sha256",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "release_id": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "public_release_approval",
      "default": "public_release_approval",
      "title": "Scope",
      "type": "string"
    },
    "signature_base64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature Base64Url",
      "type": "string"
    },
    "signer_role": {
      "const": "human_approver",
      "default": "human_approver",
      "title": "Signer Role",
      "type": "string"
    }
  },
  "required": [
    "issuer",
    "key_id_sha256",
    "local_report_sha256",
    "evidence_bundle_sha256",
    "release_id",
    "manifest_sha256",
    "artifact_sha256",
    "assurance_policy_sha256",
    "business_dossier_sha256",
    "approved_data_snapshot_sha256s",
    "decision",
    "decision_record_sha256",
    "issued_at",
    "expires_at",
    "payload_sha256",
    "signature_base64url"
  ],
  "title": "PublicReleaseApprovalAttestation",
  "type": "object"
}

      "type": "string"
    },
    "signer_role": {
      "const": "human_approver",
      "default": "human_approver",
      "title": "Signer Role",
      "type": "string"
    }
  },
  "required": [
    "issuer",
    "key_id_sha256",
    "decision",
    "report_sha256",
    "evidence_bundle_sha256",
    "plan_sha256",
    "integration_policy_sha256",
    "environment_identity_sha256",
    "deployment_candidate_sha256",
    "decision_record_sha256",
    "issued_at",
    "expires_at",
    "payload_sha256",
    "signature_base64url"

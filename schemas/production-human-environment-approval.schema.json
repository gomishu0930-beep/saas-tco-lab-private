{
  "$defs": {
    "EnvironmentApprovalDecision": {
      "enum": [
        "approve",
        "reject"
      ],
      "title": "EnvironmentApprovalDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision": {
      "$ref": "#/$defs/EnvironmentApprovalDecision"
    },
    "decision_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decision Record Sha256",
      "type": "string"
    },
    "deployment_candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Deployment Candidate Sha256",
      "type": "string"
    },
    "environment_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Identity Sha256",
      "type": "string"
    },
    "evidence_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Bundle Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "integration_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Integration Policy Sha256",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issuer": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Issuer",
      "type": "string"
    },
    "key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id Sha256",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "production_environment_human_approval",
      "default": "production_environment_human_approval",
      "title": "Scope",
      "type": "string"
    },
    "signature_base64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",

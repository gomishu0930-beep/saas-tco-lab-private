{
  "$defs": {
    "ModelTask": {
      "enum": [
        "bulk",
        "draft",
        "policy_qa"
      ],
      "title": "ModelTask",
      "type": "string"
    },
    "ModelTier": {
      "enum": [
        "luna",
        "terra",
        "sol"
      ],
      "title": "ModelTier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "evaluation_expires_at": {
      "format": "date-time",
      "title": "Evaluation Expires At",
      "type": "string"
    },
    "evaluation_passed": {
      "title": "Evaluation Passed",
      "type": "boolean"
    },
    "goldset_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Goldset Id Sha256",
      "type": "string"
    },
    "model": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Model",
      "type": "string"
    },
    "model_snapshot": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Model Snapshot",
      "type": "string"
    },
    "p95_latency_ms": {
      "minimum": 0,
      "title": "P95 Latency Ms",
      "type": "integer"
    },
    "predicted_cost_minor": {
      "minimum": 0,
      "title": "Predicted Cost Minor",
      "type": "integer"
    },
    "provider": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Provider",
      "type": "string"
    },
    "quality_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Quality Score"
    },
    "route_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Route Id Sha256",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/ModelTask"
    },
    "tier": {
      "$ref": "#/$defs/ModelTier"
    }
  },
  "required": [
    "route_id_sha256",
    "task",
    "tier",
    "provider",
    "model",
    "model_snapshot",
    "goldset_id_sha256",
    "evaluated_at",
    "evaluation_expires_at",
    "evaluation_passed",
    "quality_score",
    "predicted_cost_minor",
    "p95_latency_ms"
  ],
  "title": "EvaluatedModelRoute",
  "type": "object"
}

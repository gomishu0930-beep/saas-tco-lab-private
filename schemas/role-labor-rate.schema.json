          "type": "string"
        }
      ],
      "title": "Hourly Cost Jpy"
    },
    "role_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Role Id",
      "type": "string"
    }
  },
  "required": [
    "role_id",
    "hourly_cost_jpy"
  ],
  "title": "RoleLaborRate",
  "type": "object"
}

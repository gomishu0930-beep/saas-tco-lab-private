{
  "$defs": {
    "ActionEnvironment": {
      "enum": [
        "vendor_contact",
        "production"
      ],
      "title": "ActionEnvironment",
      "type": "string"
    },
    "ExternalAction": {
      "enum": [
        "send_rights_inquiry",
        "submit_affiliate_application",
        "activate_public_release",
        "disable_public_release"
      ],
      "title": "ExternalAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/ExternalAction"
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Sha256"
    },
    "environment": {
      "$ref": "#/$defs/ActionEnvironment"
    },
    "executor_key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Executor Key Id Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "external_action_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "External Action Policy Sha256",
      "type": "string"
    },
    "grant_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Grant Id Sha256",
      "type": "string"
    },
    "human_approval_payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Human Approval Payload Sha256",
      "type": "string"
    },
    "idempotency_key_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Idempotency Key Sha256",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issuer": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Issuer",
      "type": "string"
    },
    "key_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key Id Sha256",
      "type": "string"
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest Sha256"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "public_release_authorization_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Public Release Authorization Sha256"
    },
    "public_release_report_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Public Release Report Sha256"
    },
    "release_id": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Id"
    },
    "request_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
      "title": "Request Id",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "controller_execution_grant",
      "default": "controller_execution_grant",
      "title": "Scope",
      "type": "string"
    },
    "signature_base64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature Base64Url",
      "type": "string"
    },
    "signer_role": {
      "const": "controller",
      "default": "controller",
      "title": "Signer Role",
      "type": "string"
    }
  },
  "required": [
    "issuer",
    "key_id_sha256",
    "grant_id_sha256",
    "request_id",
    "request_sha256",
    "human_approval_payload_sha256",
    "external_action_policy_sha256",
    "action",
    "environment",
    "idempotency_key_sha256",
    "executor_key_id_sha256",
    "issued_at",
    "expires_at",
    "payload_sha256",
    "signature_base64url"
  ],
  "title": "ControllerExecutionGrant",
  "type": "object"
}
